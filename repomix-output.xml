<file path="src/services/notificationsApi.ts">
import * as SecureStore from "expo-secure-store";

const API_BASE_URL = String(
  process.env.EXPO_PUBLIC_API_BASE_URL || ""
).trim().replace(/\/+$/, "");

const ENDPOINT = `${API_BASE_URL}/api/v1/barber/notifications`;

export type NotificationType =
  | "new_booking"
  | "booking_accepted"
  | "booking_rejected"
  | "booking_cancelled"
  | "booking_completed"
  | "reschedule_requested"
  | "reschedule_approved"
  | "reschedule_declined"
  | "reschedule_withdrawn"
  | "appointment_reminder"
  | "shop_update"
  | "account_alert"
  | "general";

export type NotificationCategory =
  | "all"
  | "booking"
  | "rescheduling"
  | "other";

export interface BarberNotification {
  id: string;
  recipient_type: "barber" | "customer" | "admin";
  recipient_id: string;
  notification_type: NotificationType;
  title: string;
  message: string;
  reference_type: string | null;
  reference_id: string | null;
  action_url: string | null;
  metadata: Record<string, unknown>;
  is_read: boolean;
  read_at: string | null;
  created_at: string;
  updated_at: string;
}

export interface NotificationCounts {
  total: number;
  unread: number;
  booking: number;
  rescheduling: number;
  other: number;
}

export interface NotificationListResponse {
  notifications: BarberNotification[];
  total: number;
  limit: number;
  offset: number;
  counts: NotificationCounts;
}

export interface UnreadCountResponse {
  unread_count: number;
}

export interface NotificationActionResponse {
  message: string;
  notification: BarberNotification;
}

export interface MarkAllReadResponse {
  message: string;
  updated_count: number;
  unread_count: number;
}

export interface NotificationFilters {
  category?: NotificationCategory;
  unreadOnly?: boolean;
  limit?: number;
  offset?: number;
}

export class NotificationsApiError extends Error {
  status: number;

  constructor(message: string, status = 0) {
    super(message);
    this.name = "NotificationsApiError";
    this.status = status;
  }
}

async function getAccessToken(): Promise<string> {
  let token: string | null;

  try {
    token = await SecureStore.getItemAsync("kshurak_barber_token");
  } catch {
    throw new NotificationsApiError(
      "Unable to read your secure login session."
    );
  }

  if (!token) {
    throw new NotificationsApiError(
      "Your Barber session has expired. Please log in again.",
      401
    );
  }

  return token;
}

function getErrorMessage(status: number, data: unknown): string {
  let detail = `Notification request failed (${status}).`;

  if (data && typeof data === "object" && "detail" in data) {
    const value = (data as { detail: unknown }).detail;

    if (typeof value === "string") {
      detail = value;
    } else if (Array.isArray(value)) {
      detail = value.map((item: unknown) => {
        if (item && typeof item === "object" && "msg" in item) {
          return String((item as { msg: unknown }).msg);
        }
        return String(item);
      }).join(", ");
    } else if (
      value &&
      typeof value === "object" &&
      "message" in value
    ) {
      detail = String((value as { message: unknown }).message);
    }
  }

  if (status === 401) {
    return "Your login session is invalid or expired. Please log in again.";
  }
  if (status === 403) return `Access denied: ${detail}`;
  if (status === 404) {
    return "Notification not found or the Notifications API is unavailable.";
  }

  return detail;
}

async function notificationRequest<T>(
  path: string,
  method: "GET" | "POST" | "PATCH" = "GET",
  body?: unknown,
  signal?: AbortSignal
): Promise<T> {
  if (!/^https?:\/\/[^/]+/i.test(API_BASE_URL)) {
    throw new NotificationsApiError(
      "EXPO_PUBLIC_API_BASE_URL is missing or invalid."
    );
  }

  const token = await getAccessToken();
  const headers: Record<string, string> = {
    Authorization: `Bearer ${token}`,
    Accept: "application/json",
  };

  if (body !== undefined) {
    headers["Content-Type"] = "application/json";
  }

  let response: Response;

  try {
    response = await fetch(`${ENDPOINT}${path}`, {
      method,
      headers,
      body: body === undefined ? undefined : JSON.stringify(body),
      signal,
    });
  } catch (error: unknown) {
    if (
      signal?.aborted ||
      (error instanceof Error && error.name === "AbortError")
    ) {
      throw error;
    }

    throw new NotificationsApiError(
      "Unable to connect to KSHURAK. Check the server and your connection."
    );
  }

  const data: unknown = await response.json().catch(() => null);

  if (!response.ok) {
    throw new NotificationsApiError(
      getErrorMessage(response.status, data),
      response.status
    );
  }

  if (data === null || data === undefined) {
    throw new NotificationsApiError(
      "The Notifications API returned an empty response."
    );
  }

  return data as T;
}

function safeInteger(value: number | undefined, fallback: number): number {
  return typeof value === "number" && Number.isFinite(value)
    ? Math.floor(value)
    : fallback;
}

export async function getNotifications(
  filters: NotificationFilters = {},
  signal?: AbortSignal
): Promise<NotificationListResponse> {
  const limit = Math.min(100, Math.max(1, safeInteger(filters.limit, 30)));
  const offset = Math.max(0, safeInteger(filters.offset, 0));

  const params = [
    `category=${encodeURIComponent(filters.category || "all")}`,
    `limit=${limit}`,
    `offset=${offset}`,
  ];

  if (filters.unreadOnly !== undefined) {
    params.push(`unread_only=${String(filters.unreadOnly)}`);
  }

  const result = await notificationRequest<NotificationListResponse>(
    `?${params.join("&")}`,
    "GET",
    undefined,
    signal
  );

  if (
    !result ||
    !Array.isArray(result.notifications) ||
    !result.counts ||
    !Number.isFinite(result.total) ||
    result.total < 0
  ) {
    throw new NotificationsApiError(
      "Invalid notification list received from the backend."
    );
  }

  return result;
}

export function getUnreadNotificationCount(
  signal?: AbortSignal
): Promise<UnreadCountResponse> {
  return notificationRequest("/unread-count", "GET", undefined, signal);
}

export function getNotificationById(
  notificationId: string,
  signal?: AbortSignal
): Promise<BarberNotification> {
  return notificationRequest(
    `/${encodeURIComponent(notificationId)}`,
    "GET",
    undefined,
    signal
  );
}

export function markNotificationAsRead(
  notificationId: string
): Promise<NotificationActionResponse> {
  return notificationRequest(
    `/${encodeURIComponent(notificationId)}/read`,
    "PATCH"
  );
}

export function markAllNotificationsAsRead(): Promise<MarkAllReadResponse> {
  return notificationRequest("/read-all", "POST");
}
</file>

<file path="src/services/registrationCorrectionApi.ts">
const API_BASE_URL = String(
  process.env.EXPO_PUBLIC_API_BASE_URL || ""
)
  .trim()
  .replace(/\/+$/, "");

const CORRECTION_PATH =
  "/api/v1/barber/registration-correction";

const REQUEST_TIMEOUT_MS = Number(
  process.env.EXPO_PUBLIC_CORRECTION_REQUEST_TIMEOUT_MS ||
    "30000"
);

const IMAGE_TYPES = [
  "image/jpeg",
  "image/png",
  "image/webp",
];

const DOCUMENT_TYPES = [
  ...IMAGE_TYPES,
  "application/pdf",
];

const MAX_IMAGE_BYTES = 8 * 1024 * 1024;
const MAX_DOCUMENT_BYTES = 5 * 1024 * 1024;
const MAX_DOCUMENTS = 5;

export interface CorrectionFile {
  uri: string;
  name: string;
  mimeType: string;
  size: number;
}

export interface CorrectionDocument {
  path: string;
  original_name?: string;
  content_type?: string;
  size?: number;
  document_type?: string;
  signed_url?: string | null;
}

export interface RegistrationCorrectionDetails {
  barber_id: string;
  username: string;
  email: string;
  approval_status: "needs_correction";

  shop_name: string | null;
  shop_phone: string | null;
  shop_address: string;
  years_experience: number;

  correction_reason: string;
  correction_requested_at: string;
  token_expires_at: string;

  shop_image_url: string | null;
  documents: CorrectionDocument[];
  signed_url_expires_in: number;
}

export interface RegistrationCorrectionPayload {
  token: string;
  shop_name: string;
  shop_phone: string;
  shop_address: string;
  years_experience: number;

  shop_image?: CorrectionFile | null;

  // A non-empty set replaces all saved verification documents.
  // An empty set retains the existing documents.
  shop_documents?: CorrectionFile[];
}

export interface RegistrationCorrectionResult {
  barber_id: string;
  approval_status: "pending";
  correction_resubmitted_at: string;
  message: string;
}

export class RegistrationCorrectionError extends Error {
  readonly status: number;
  readonly outcomeUnknown: boolean;

  constructor(
    message: string,
    status = 0,
    outcomeUnknown = false
  ) {
    super(message);
    this.name = "RegistrationCorrectionError";
    this.status = status;
    this.outcomeUnknown = outcomeUnknown;
  }
}

function isRecord(
  value: unknown
): value is Record<string, unknown> {
  return (
    typeof value === "object" &&
    value !== null &&
    !Array.isArray(value)
  );
}

function isNullableString(value: unknown): boolean {
  return value === null || typeof value === "string";
}

function isTimestamp(value: unknown): boolean {
  return (
    typeof value === "string" &&
    Number.isFinite(Date.parse(value))
  );
}

function requireBaseUrl(): string {
  try {
    const url = new URL(API_BASE_URL);

    if (
      !["http:", "https:"].includes(url.protocol) ||
      url.username ||
      url.password ||
      url.search ||
      url.hash
    ) {
      throw new Error("Invalid API address.");
    }

    return API_BASE_URL;
  } catch {
    throw new RegistrationCorrectionError(
      "EXPO_PUBLIC_API_BASE_URL is missing or invalid.",
      422
    );
  }
}

function requireToken(token: string): string {
  const value = token.trim();

  if (value.length < 32 || value.length > 512) {
    throw new RegistrationCorrectionError(
      "This correction link is invalid. Please request a new link from Admin.",
      401
    );
  }

  return value;
}

function getErrorMessage(
  data: unknown,
  responseStatus: number
): string {
  if (isRecord(data)) {
    const detail = data.detail;

    if (typeof detail === "string") {
      return detail;
    }

    if (
      isRecord(detail) &&
      typeof detail.message === "string"
    ) {
      return detail.message;
    }

    if (Array.isArray(detail)) {
      const messages = detail.flatMap(
        (item: unknown) => {
          if (
            !isRecord(item) ||
            typeof item.msg !== "string"
          ) {
            return [];
          }

          const field = Array.isArray(item.loc)
            ? item.loc
                .filter((part) => part !== "body")
                .map(String)
                .join(".")
            : "";

          return [
            field
              ? `${field}: ${item.msg}`
              : item.msg,
          ];
        }
      );

      if (messages.length) {
        return messages.join("\n");
      }
    }
  }

  switch (responseStatus) {
    case 401:
      return (
        "This correction link is invalid, expired or already used. " +
        "Please request a new link from Admin."
      );

    case 409:
      return (
        "This registration is no longer awaiting corrections. " +
        "Reload the application status."
      );

    case 413:
      return "An uploaded file exceeds the allowed size.";

    case 429:
      return "Too many requests. Please wait before trying again.";

    case 503:
      return "The correction service is temporarily unavailable.";

    default:
      return "Unable to complete the request. Please try again.";
  }
}

async function postCorrectionRequest(
  endpoint: "/validate" | "/resubmit",
  body: string | FormData,
  isJson: boolean,
  externalSignal?: AbortSignal
): Promise<unknown> {
  const baseUrl = requireBaseUrl();

  if (
    !Number.isFinite(REQUEST_TIMEOUT_MS) ||
    REQUEST_TIMEOUT_MS <= 0
  ) {
    throw new RegistrationCorrectionError(
      "EXPO_PUBLIC_CORRECTION_REQUEST_TIMEOUT_MS must be a positive number.",
      422
    );
  }

  const controller = new AbortController();
  const isSubmission = endpoint === "/resubmit";

  let timedOut = false;

  const abortFromCaller = () => {
    controller.abort();
  };

  if (externalSignal?.aborted) {
    controller.abort();
  } else {
    externalSignal?.addEventListener(
      "abort",
      abortFromCaller,
      { once: true }
    );
  }

  const timer = setTimeout(() => {
    timedOut = true;
    controller.abort();
  }, REQUEST_TIMEOUT_MS);

  try {
    const response = await fetch(
      `${baseUrl}${CORRECTION_PATH}${endpoint}`,
      {
        method: "POST",
        headers: {
          Accept: "application/json",
          ...(isJson
            ? { "Content-Type": "application/json" }
            : {}),
        },
        body,
        signal: controller.signal,
      }
    );

    // Keep the timeout active while reading the response body.
    const data: unknown = await response
      .json()
      .catch((error: unknown) => {
        if (controller.signal.aborted) {
          throw error;
        }

        return null;
      });

    if (!response.ok) {
      throw new RegistrationCorrectionError(
        getErrorMessage(data, response.status),
        response.status,
        isSubmission && response.status >= 500
      );
    }

    if (data === null) {
      throw new RegistrationCorrectionError(
        isSubmission
          ? "The submission response could not be verified. Reload the application status before retrying."
          : "The correction service returned an invalid response.",
        0,
        isSubmission
      );
    }

    return data;
  } catch (error: unknown) {
    if (externalSignal?.aborted) {
      throw error;
    }

    if (error instanceof RegistrationCorrectionError) {
      throw error;
    }

    throw new RegistrationCorrectionError(
      isSubmission
        ? (
            timedOut
              ? "The submission timed out. "
              : "The connection was interrupted. "
          ) +
            "Your submission outcome is unknown. Reload the application status before retrying."
        : timedOut
          ? "Loading your application timed out. Check your connection and retry validation."
          : "Unable to connect to KSHURAK. Check your connection and backend address.",
      0,
      isSubmission
    );
  } finally {
    clearTimeout(timer);

    externalSignal?.removeEventListener(
      "abort",
      abortFromCaller
    );
  }
}

function appendFile(
  form: FormData,
  field: string,
  file: CorrectionFile,
  imageOnly: boolean
): void {
  const allowed = imageOnly
    ? IMAGE_TYPES
    : DOCUMENT_TYPES;

  const maximum = imageOnly
    ? MAX_IMAGE_BYTES
    : MAX_DOCUMENT_BYTES;

  if (
    !file.uri ||
    !file.name ||
    !allowed.includes(file.mimeType) ||
    !Number.isFinite(file.size) ||
    file.size <= 0 ||
    file.size > maximum
  ) {
    throw new RegistrationCorrectionError(
      imageOnly
        ? "Select a valid JPEG, PNG or WebP shop image up to 8 MB."
        : "Select valid PDF, JPEG, PNG or WebP documents up to 5 MB each.",
      422
    );
  }

  // React Native accepts local file descriptors in FormData.
  form.append(
    field,
    {
      uri: file.uri,
      name: file.name,
      type: file.mimeType,
    } as unknown as Blob
  );
}

export async function validateRegistrationCorrection(
  token: string,
  signal?: AbortSignal
): Promise<RegistrationCorrectionDetails> {
  const data = await postCorrectionRequest(
    "/validate",
    JSON.stringify({
      token: requireToken(token),
    }),
    true,
    signal
  );

  if (
    !isRecord(data) ||
    typeof data.barber_id !== "string" ||
    typeof data.username !== "string" ||
    typeof data.email !== "string" ||
    data.approval_status !== "needs_correction" ||
    !isNullableString(data.shop_name) ||
    !isNullableString(data.shop_phone) ||
    typeof data.shop_address !== "string" ||
    typeof data.years_experience !== "number" ||
    !Number.isInteger(data.years_experience) ||
    data.years_experience < 0 ||
    data.years_experience > 50 ||
    typeof data.correction_reason !== "string" ||
    !isTimestamp(data.correction_requested_at) ||
    !isTimestamp(data.token_expires_at) ||
    !isNullableString(data.shop_image_url) ||
    typeof data.signed_url_expires_in !== "number" ||
    !Number.isFinite(data.signed_url_expires_in) ||
    !Array.isArray(data.documents) ||
    !data.documents.every(
      (document: unknown) =>
        isRecord(document) &&
        typeof document.path === "string" &&
        (
          document.original_name === undefined ||
          typeof document.original_name === "string"
        ) &&
        (
          document.signed_url === undefined ||
          isNullableString(document.signed_url)
        )
    )
  ) {
    throw new RegistrationCorrectionError(
      "The backend returned an unexpected correction response. Please contact support."
    );
  }

  return data as unknown as RegistrationCorrectionDetails;
}

export async function resubmitRegistrationCorrection(
  payload: RegistrationCorrectionPayload
): Promise<RegistrationCorrectionResult> {
  const documents = payload.shop_documents ?? [];

  if (documents.length > MAX_DOCUMENTS) {
    throw new RegistrationCorrectionError(
      "Select a maximum of 5 verification documents.",
      422
    );
  }

  const form = new FormData();

  form.append("token", requireToken(payload.token));
  form.append("shop_name", payload.shop_name.trim());
  form.append("shop_phone", payload.shop_phone.trim());
  form.append("shop_address", payload.shop_address.trim());
  form.append(
    "years_experience",
    String(payload.years_experience)
  );

  if (payload.shop_image) {
    appendFile(
      form,
      "shop_image",
      payload.shop_image,
      true
    );
  }

  for (const document of documents) {
    appendFile(
      form,
      "shop_documents",
      document,
      false
    );
  }

  // Do not set Content-Type manually.
  // React Native supplies the multipart boundary.
  const data = await postCorrectionRequest(
    "/resubmit",
    form,
    false
  );

  if (
    !isRecord(data) ||
    typeof data.barber_id !== "string" ||
    data.approval_status !== "pending" ||
    !isTimestamp(data.correction_resubmitted_at) ||
    typeof data.message !== "string"
  ) {
    throw new RegistrationCorrectionError(
      "The submission response was unexpected. Reload the application status before retrying.",
      0,
      true
    );
  }

  return data as unknown as RegistrationCorrectionResult;
}
</file>

<file path="src/services/reschedulingApi.ts">
import * as SecureStore from "expo-secure-store";

// ============================================================
// CONFIGURATION
// ============================================================

const API_BASE_URL = String(
  process.env.EXPO_PUBLIC_API_BASE_URL || ""
)
  .trim()
  .replace(/\/+$/, "");

const RESCHEDULING_ENDPOINT =
  `${API_BASE_URL}/api/v1/barber/rescheduling`;

const PRIMARY_TOKEN_KEY = "kshurak_barber_token";
const LEGACY_TOKEN_KEY = "barber_access_token";

// ============================================================
// TYPES - MATCH WEB APP
// ============================================================

export type RescheduleStatus =
  | "pending"
  | "approved"
  | "declined"
  | "cancelled";

export type RescheduleRequester =
  | "barber"
  | "customer";

export type RescheduleRequestKind =
  | "appointment_change"
  | "worker_unavailability";

export type RecoveryOptionType =
  | "cancel_booking"
  | "same_worker_other_day"
  | "other_worker_same_day";

// ============================================================
// RECOVERY OPTIONS
// ============================================================

export interface RecoveryOption {
  id: string;
  request_id: string;
  option_type: RecoveryOptionType;

  worker_id: string | null;

  appointment_date: string | null;
  start_time: string | null;
  end_time: string | null;

  created_at: string;
}

// ============================================================
// RESCHEDULE REQUEST
// ============================================================

export interface RescheduleRequest {
  id: string;
  booking_id: string;

  requested_by: RescheduleRequester;

  requested_date: string;
  requested_start_time: string;
  requested_end_time: string;

  requested_worker_id: string | null;

  original_date: string;
  original_start_time: string;
  original_end_time: string;

  original_worker_id: string | null;

  status: RescheduleStatus;

  reason: string | null;
  decision_reason: string | null;

  decided_by: RescheduleRequester | null;
  decided_at: string | null;

  created_at: string;
  updated_at: string;

  customer_name: string;
  customer_phone: string;

  service_name: string;
  service_price: number;

  booking_status: string;

  request_kind: RescheduleRequestKind;

  selected_option_type:
    | RecoveryOptionType
    | null;

  options: RecoveryOption[];
}

// ============================================================
// COUNTS AND RESPONSES
// ============================================================

export interface RescheduleCounts {
  pending: number;
  approved: number;
  declined: number;
  cancelled: number;
}

export interface RescheduleListResponse {
  requests: RescheduleRequest[];
  total: number;
  counts: RescheduleCounts;
}

export interface RescheduleActionResponse {
  message: string;
  request: RescheduleRequest;
}

// ============================================================
// ELIGIBLE BOOKINGS - EXACT WEB APP TYPE STRUCTURE
// ============================================================

export interface EligibleRescheduleBooking {
  id: string;

  barber_id: string;
  worker_id: string;
  customer_id: string;

  customer_name: string;
  customer_phone: string;
  customer_image_url: string | null;

  worker_name: string | null;

  service_name: string;
  service_duration_minutes: number;
  service_price: number | string;

  booking_date: string;
  start_time: string;
  end_time: string;

