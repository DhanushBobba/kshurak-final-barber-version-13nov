import {
  useCallback,
  useEffect,
  useMemo,
  useRef,
  useState,
  type ReactNode,
} from "react";

import {
  ActivityIndicator,
  Alert,
  AppState,
  FlatList,
  Modal,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
  useWindowDimensions,
} from "react-native";

import {
  SafeAreaView,
  useSafeAreaInsets,
} from "react-native-safe-area-context";

import { useIsFocused } from "@react-navigation/native";

import {
  ArrowLeft,
  ArrowRight,
  Bell,
  BellRing,
  CalendarClock,
  CalendarDays,
  Check,
  CheckCheck,
  CheckCircle2,
  ChevronLeft,
  ChevronRight,
  Clock3,
  Inbox,
  RefreshCw,
  Search,
  ShieldCheck,
  Sparkles,
  Store,
  X,
  type LucideIcon,
} from "lucide-react-native";

import { COLORS } from "../../constants/colors";

import {
  getNotifications,
  markAllNotificationsAsRead,
  markNotificationAsRead,
  type BarberNotification,
  type NotificationCategory,
  type NotificationCounts,
} from "../../services/notificationsApi";

// ============================================================
// TYPES
// ============================================================

type Destination =
  | "Bookings"
  | "Rescheduling"
  | "ShopSetup"
  | "Workers"
  | "Dashboard";

type Props = {
  onBack: () => void;
  onNavigate: (screen: Destination) => void;
};

type CardType =
  | "all"
  | "unread"
  | "booking"
  | "rescheduling";

type SummaryCard = {
  key: CardType;
  title: string;
  description: string;
  icon: LucideIcon;
};

// ============================================================
// THEME
// ============================================================

const C = COLORS;
const GOLD = C.primary;
const BG = C.background;
const SURFACE = C.surface;
const DARK = C.surfaceDark;
const LIGHT = C.surfaceLight;
const BORDER = C.border;
const MUTED = C.textSecondary;
const SUCCESS = C.success;
const ERROR = C.error;

const GOLD_SOFT = "rgba(245,158,11,0.09)";
const GOLD_BORDER = "rgba(245,158,11,0.35)";
const GREEN_SOFT = "rgba(34,197,94,0.09)";

const PAGE_SIZE = 15;
const POLL_INTERVAL = 15000;

const EMPTY_COUNTS: NotificationCounts = {
  total: 0,
  unread: 0,
  booking: 0,
  rescheduling: 0,
  other: 0,
};

const SUMMARY_CARDS: SummaryCard[] = [
  {
    key: "all",
    title: "All Notifications",
    description: "Total shop activity",
    icon: Bell,
  },
  {
    key: "unread",
    title: "Unread Alerts",
    description: "Needs attention",
    icon: BellRing,
  },
  {
    key: "booking",
    title: "Booking Alerts",
    description: "Appointment updates",
    icon: CalendarDays,
  },
  {
    key: "rescheduling",
    title: "Rescheduling",
    description: "Schedule changes",
    icon: CalendarClock,
  },
];

// ============================================================
// HELPERS
// ============================================================

function getCategory(
  item: BarberNotification
): string {
  const type = String(item.notification_type);

  if (type.startsWith("reschedule_")) {
    return "Rescheduling";
  }

  if (
    type.startsWith("booking_") ||
    type === "new_booking" ||
    type === "appointment_reminder"
  ) {
    return "Booking";
  }

  if (type === "shop_update") return "Shop";
  if (type === "account_alert") return "Account";

  return "General";
}

function getCategoryIcon(
  category: string
): LucideIcon {
  switch (category) {
    case "Booking":
      return CalendarDays;
    case "Rescheduling":
      return CalendarClock;
    case "Shop":
      return Store;
    case "Account":
      return ShieldCheck;
    default:
      return Bell;
  }
}

function formatDate(value: string): string {
  const date = new Date(value);

  if (!Number.isFinite(date.getTime())) {
    return value || "Date unavailable";
  }

  return date.toLocaleString("en-IN", {
    timeZone: "Asia/Kolkata",
    day: "numeric",
    month: "short",
    year: "numeric",
    hour: "numeric",
    minute: "2-digit",
  });
}

function getDestination(
  item: BarberNotification
): Destination | null {
  const pathname = item.action_url
    ?.split("?")[0]
    .split("#")[0]
    .replace(/\/+$/, "");

  switch (pathname) {
    case "/bookings":
      return "Bookings";
    case "/rescheduling":
      return "Rescheduling";
    case "/shop-setup":
      return "ShopSetup";
    case "/workers":
      return "Workers";
    case "/dashboard":
      return "Dashboard";
  }

  switch (item.reference_type) {
    case "booking":
      return "Bookings";
    case "rescheduling":
      return "Rescheduling";
    case "worker":
      return "Workers";
    case "shop":
      return "ShopSetup";
    case "account":
      return "Dashboard";
    default:
      return null;
  }
}

function getCount(
  card: CardType,
  counts: NotificationCounts
): number {
  if (card === "all") return counts.total;
  if (card === "unread") return counts.unread;
  return counts[card];
}

function messageOf(error: unknown): string {
  return error instanceof Error
    ? error.message
    : "An unexpected error occurred.";
}

// ============================================================
// PREMIUM BUTTON
// ============================================================

function Button({
  title,
  onPress,
  primary = false,
  disabled = false,
  busy = false,
  icon,
}: {
  title: string;
  onPress: () => void;
  primary?: boolean;
  disabled?: boolean;
  busy?: boolean;
  icon?: ReactNode;
}) {
  return (
    <Pressable
      accessibilityRole="button"
      accessibilityState={{
        disabled: disabled || busy,
        busy,
      }}
      disabled={disabled || busy}
      onPress={onPress}
      style={({ pressed }) => [
        styles.button,
        primary && styles.primaryButton,
        disabled && styles.disabled,
        pressed && !disabled && styles.pressed,
      ]}
    >
      {busy ? (
        <ActivityIndicator
          size="small"
          color={primary ? BG : GOLD}
        />
      ) : (
        icon
      )}

      <Text
        style={[
          styles.buttonText,
          primary && styles.primaryButtonText,
        ]}
      >
        {title}
      </Text>
    </Pressable>
  );
}

// ============================================================
// NOTICES
// ============================================================

function Notice({
  text,
  success = false,
}: {
  text: string;
  success?: boolean;
}) {
  if (!text) return null;

  const color = success ? SUCCESS : ERROR;

  return (
    <View
      style={[
        styles.notice,
        { borderColor: `${color}65` },
      ]}
    >
      {success ? (
        <CheckCircle2 size={18} color={color} />
      ) : (
        <ShieldCheck size={18} color={color} />
      )}

      <Text
        style={[
          styles.noticeText,
          { color },
        ]}
      >
        {text}
      </Text>
    </View>
  );
}

// ============================================================
// SUMMARY CARD
// ============================================================

function PremiumSummaryCard({
  item,
  count,
  active,
  disabled,
  onPress,
}: {
  item: SummaryCard;
  count: number | string;
  active: boolean;
  disabled: boolean;
