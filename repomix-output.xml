  useWindowDimensions,
} from "react-native";

import {
  SafeAreaView,
  useSafeAreaInsets,
} from "react-native-safe-area-context";

import { useIsFocused } from "@react-navigation/native";

import {
  ArrowLeft,
  ArrowRight,
  CheckCircle2,
  ChevronLeft,
  ChevronRight,
  Clock3,
  Edit3,
  Plus,
  RefreshCw,
  Scissors,
  Search,
  ShieldCheck,
  Sparkles,
  X,
  type LucideIcon,
} from "lucide-react-native";

import { COLORS } from "../../constants/colors";

import {
  createBarberService,
  getBarberServices,
  setBarberServiceStatus,
  updateBarberService,
  type BarberService,
  type ServicePayload,
  type ServiceActionResponse,
} from "../../services/servicesApi";

// ============================================================
// TYPES
// ============================================================

type Props = {
  onBack: () => void;
};

type StatusFilter = "all" | "active" | "inactive";

type Category =
  | "all"
  | "haircut"
  | "beard"
  | "shave"
  | "facial"
  | "haircare"
  | "package"
  | "other";

type FormValues = {
  service_name: string;
  description: string;
  duration_minutes: string;
  price: string;
};

type Metric = {
  label: string;
  value: string | number;
  icon: LucideIcon;
  tone: "gold" | "green" | "muted";
};

// ============================================================
// CONSTANTS
// ============================================================

const PAGE_SIZE = 8;

const EMPTY_FORM: FormValues = {
  service_name: "",
  description: "",
  duration_minutes: "30",
  price: "",
};

const CATEGORIES: {
  key: Category;
  title: string;
}[] = [
  { key: "all", title: "All Services" },
  { key: "haircut", title: "Haircuts" },
  { key: "beard", title: "Beard" },
  { key: "shave", title: "Shaving" },
  { key: "facial", title: "Facials" },
  { key: "haircare", title: "Hair Care" },
  { key: "package", title: "Packages" },
  { key: "other", title: "Other" },
];

const C = COLORS;
const GOLD = C.primary;
const BG = C.background;
const SURFACE = C.surface;
const DARK = C.surfaceDark;
const LIGHT = C.surfaceLight;
const BORDER = C.border;
const MUTED = C.textSecondary;
const SUCCESS = C.success;
const ERROR = C.error;

const GOLD_SOFT = "rgba(245,158,11,0.09)";
const GOLD_BORDER = "rgba(245,158,11,0.35)";
const GREEN_SOFT = "rgba(34,197,94,0.09)";
const GREEN_BORDER = "rgba(34,197,94,0.35)";

// ============================================================
// HELPERS
// ============================================================

function getCategory(name: string): Category {
  const value = String(name || "").toLowerCase();

  if (/package|combo|bundle|ritual/.test(value))
    return "package";

  if (/beard|moustache/.test(value))
    return "beard";

  if (/shave|shaving/.test(value))
    return "shave";

  if (/facial|face|skin|cleanup/.test(value))
    return "facial";

  if (/haircut|hair cut|fade|scissor/.test(value))
    return "haircut";

  if (/hair|spa|color|colour/.test(value))
    return "haircare";

  return "other";
}

function categoryLabel(category: Category): string {
  return (
    CATEGORIES.find((item) => item.key === category)?.title ||
    "Other"
  );
}

function formatPrice(value: number | string): string {
  const amount = Number(value);

  return Number.isFinite(amount)
    ? `₹${amount.toLocaleString("en-IN", {
        maximumFractionDigits: 2,
      })}`
    : "—";
}

function formatDuration(value: number): string {
  const minutes = Number(value);

  if (!Number.isFinite(minutes)) return "—";

  if (minutes >= 60 && minutes % 60 === 0) {
    return `${minutes / 60} hr`;
  }

  return `${minutes} min`;
}

function errorMessage(error: unknown): string {
  return error instanceof Error
    ? error.message
    : "Something went wrong. Please try again.";
}

function validateForm(values: FormValues): ServicePayload {
  const service_name = values.service_name.trim();
  const description = values.description.trim();
  const duration = Number(values.duration_minutes);
  const price = Number(values.price);

  if (!service_name || service_name.length > 150) {
    throw new Error(
      "Service name must contain 1 to 150 characters."
    );
  }

  if (description.length > 2000) {
    throw new Error(
      "Description must not exceed 2000 characters."
    );
  }

  if (
    !values.duration_minutes.trim() ||
    !Number.isInteger(duration) ||
    duration < 5 ||
    duration > 480
  ) {
    throw new Error(
      "Duration must be between 5 and 480 minutes."
    );
  }

  if (
    !/^\d+(\.\d{1,2})?$/.test(values.price.trim()) ||
    !Number.isFinite(price) ||
    price < 0 ||
    price > 9999999999.99
  ) {
    throw new Error("Enter a valid service price.");
  }

  return {
    service_name,
    description: description || null,
    duration_minutes: duration,
    price,
  };
}

// ============================================================
// REUSABLE BUTTON
// ============================================================

function ActionButton({
  title,
  onPress,
  icon: Icon,
  primary = false,
  danger = false,
  disabled = false,
  loading = false,
}: {
  title: string;
  onPress: () => void;
  icon?: LucideIcon;
  primary?: boolean;
  danger?: boolean;
  disabled?: boolean;
  loading?: boolean;
}) {
  const color = primary
    ? BG
    : danger
    ? ERROR
    : GOLD;

  return (
    <Pressable
      accessibilityRole="button"
      accessibilityState={{ disabled, busy: loading }}
      disabled={disabled || loading}
      onPress={onPress}
      style={({ pressed }) => [
        styles.actionButton,
        primary && styles.actionPrimary,
        danger && styles.actionDanger,
        (disabled || loading) && styles.disabled,
        pressed && !disabled && styles.pressed,
      ]}
    >
      {loading ? (
        <ActivityIndicator size="small" color={color} />
      ) : Icon ? (
        <Icon size={15} color={color} />
      ) : null}

      <Text
        style={[
          styles.actionText,
          primary && styles.actionPrimaryText,
          danger && { color: ERROR },
        ]}
      >
        {title}
      </Text>
    </Pressable>
  );
}

