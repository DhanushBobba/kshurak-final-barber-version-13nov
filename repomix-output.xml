// ============================================================
// MAIN COMPONENT
// ============================================================

export default function ServicesScreen({
  onBack,
}: Props) {
  const focused = useIsFocused();
  const insets = useSafeAreaInsets();
  const { width } = useWindowDimensions();

  const mounted = useRef(false);
  const requestId = useRef(0);
  const controller = useRef<AbortController | null>(null);
  const mutation = useRef(false);

  const [services, setServices] =
    useState<BarberService[]>([]);

  const [loaded, setLoaded] = useState(false);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [saving, setSaving] = useState(false);

  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");

  const [search, setSearch] = useState("");
  const [status, setStatus] =
    useState<StatusFilter>("all");

  const [category, setCategory] =
    useState<Category>("all");

  const [page, setPage] = useState(0);

  const [editorVisible, setEditorVisible] =
    useState(false);

  const [editing, setEditing] =
    useState<BarberService | null>(null);

  const [form, setForm] =
    useState<FormValues>({ ...EMPTY_FORM });

  const [formSnapshot, setFormSnapshot] =
    useState("");

  const [formError, setFormError] = useState("");

  const busy = loading || refreshing || saving;

  // ==========================================================
  // LOAD DATA
  // ==========================================================

  const loadServices = useCallback(
    async (refresh = false) => {
      const currentId = ++requestId.current;

      controller.current?.abort();
      const abort = new AbortController();
      controller.current = abort;

      if (mounted.current) {
        setLoading(!refresh);
        setRefreshing(refresh);
        setError("");
      }

      try {
        const response = await getBarberServices(
          false,
          abort.signal
        );

        if (
          !mounted.current ||
          abort.signal.aborted ||
          currentId !== requestId.current
        ) {
          return;
        }

        setServices(response.services);
        setLoaded(true);
      } catch (err: unknown) {
        if (
          mounted.current &&
          !abort.signal.aborted &&
          currentId === requestId.current
        ) {
          setError(errorMessage(err));
        }
      } finally {
        if (
          mounted.current &&
          currentId === requestId.current
        ) {
          setLoading(false);
          setRefreshing(false);
        }
      }
    },
    []
  );

  useEffect(() => {
    mounted.current = true;

    return () => {
      mounted.current = false;
      requestId.current++;
      controller.current?.abort();
    };
  }, []);

  useEffect(() => {
    if (!focused) return;

    void loadServices();

    return () => {
      requestId.current++;
      controller.current?.abort();
    };
  }, [focused, loadServices]);

  // ==========================================================
  // METRICS
  // ==========================================================

  const totalCount = services.length;

  const activeCount = services.filter(
    (item) => item.is_active
  ).length;

  const inactiveCount = totalCount - activeCount;

  const avgDuration = totalCount
    ? Math.round(
        services.reduce(
          (sum, item) =>
            sum + Number(item.duration_minutes || 0),
          0
        ) / totalCount
      )
    : 0;

  const metrics: Metric[] = [
    {
      label: "Total Services",
      value: loaded ? totalCount : "—",
      icon: Scissors,
      tone: "gold",
    },
    {
      label: "Active Services",
      value: loaded ? activeCount : "—",
      icon: CheckCircle2,
      tone: "green",
    },
    {
      label: "Inactive Services",
      value: loaded ? inactiveCount : "—",
      icon: ShieldCheck,
      tone: "muted",
    },
    {
      label: "Average Duration",
      value: loaded ? `${avgDuration}m` : "—",
      icon: Clock3,
      tone: "gold",
    },
  ];

  // ==========================================================
  // FILTERING
  // ==========================================================

  const filtered = useMemo(() => {
    const query = search.trim().toLowerCase();

    return services.filter((item) => {
      if (status === "active" && !item.is_active) {
        return false;
      }

      if (status === "inactive" && item.is_active) {
        return false;
      }

      if (
        category !== "all" &&
        getCategory(item.service_name) !== category
      ) {
        return false;
      }

      if (!query) return true;

      return (
        item.service_name.toLowerCase().includes(query) ||
        String(item.description || "")
          .toLowerCase()
          .includes(query)
      );
    });
  }, [services, search, status, category]);

  useEffect(() => {
    setPage(0);
  }, [search, status, category]);

  const totalPages = Math.max(
    1,
    Math.ceil(filtered.length / PAGE_SIZE)
  );

  const currentPage = Math.min(page, totalPages - 1);

  const visibleServices = filtered.slice(
    currentPage * PAGE_SIZE,
    (currentPage + 1) * PAGE_SIZE
  );

  const metricWidth =
    width < 340
      ? "100%"
      : width >= 760
      ? "23.5%"
      : "48.5%";

  // ==========================================================
  // REFRESH
  // ==========================================================

  const refresh = () => {
    if (mutation.current || busy) return;

    setSuccess("");
    void loadServices(true);
  };

  // ==========================================================
  // EDITOR
  // ==========================================================

  const openEditor = (service?: BarberService) => {
    if (mutation.current || busy) return;

    const values: FormValues = service
      ? {
          service_name: service.service_name,
          description: service.description || "",
          duration_minutes: String(
            service.duration_minutes
          ),
          price: String(service.price),
        }
      : { ...EMPTY_FORM };

    setEditing(service || null);
    setForm(values);
    setFormSnapshot(JSON.stringify(values));
    setFormError("");
    setEditorVisible(true);
  };

  const closeEditor = () => {
    if (mutation.current) return;

    if (JSON.stringify(form) !== formSnapshot) {
      Alert.alert(
        "Discard Changes?",
        "Your unsaved service changes will be lost.",
        [
          {
            text: "Continue Editing",
            style: "cancel",
          },
          {
            text: "Discard",
            style: "destructive",
            onPress: () => setEditorVisible(false),
          },
        ]
      );
      return;
    }

    setEditorVisible(false);
  };

  const changeForm = (
    key: keyof FormValues,
    value: string
  ) => {
    setForm((current) => ({
      ...current,
      [key]: value,
    }));

    setFormError("");
  };

  // ==========================================================
  // APPLY API RESULT
  // ==========================================================

  const applyResult = (result: ServiceActionResponse) => {
    setServices((current) => {
      const exists = current.some(
        (item) => item.id === result.service.id
      );

      if (exists) {
        return current.map((item) =>
          item.id === result.service.id
            ? result.service
            : item
        );
      }

      return [result.service, ...current];
    });

    setLoaded(true);

    setSuccess(
      result.message || "Service updated successfully."
    );
  };

  // ==========================================================
  // SAVE SERVICE
  // ==========================================================

  const saveService = async () => {
    if (mutation.current) return;

    let payload: ServicePayload;

    try {
      payload = validateForm(form);
    } catch (err: unknown) {
      setFormError(errorMessage(err));
      return;
    }

    mutation.current = true;
    setSaving(true);
    setFormError("");
    setError("");

    try {
      const result = editing
        ? await updateBarberService(editing.id, payload)
        : await createBarberService(payload);

      if (!mounted.current) return;

      applyResult(result);

      setEditorVisible(false);

      if (!editing) {
        setSearch("");
        setCategory("all");
        setStatus("all");
        setPage(0);
      }
    } catch (err: unknown) {
      if (mounted.current) {
        setFormError(errorMessage(err));
      }
    } finally {
      mutation.current = false;

      if (mounted.current) {
        setSaving(false);
      }
    }
  };

  // ==========================================================
  // TOGGLE ACTIVE STATUS
  // ==========================================================

  const toggleService = (service: BarberService) => {
    if (mutation.current || busy) return;

    Alert.alert(
      service.is_active
        ? "Deactivate Service?"
        : "Activate Service?",
      `Are you sure you want to ${
        service.is_active ? "deactivate" : "activate"
      } "${service.service_name}"?`,
      [
        {
          text: "Cancel",
          style: "cancel",
        },
        {
          text: "Confirm",
          onPress: () => {
            void (async () => {
              if (mutation.current) return;

              mutation.current = true;
              setSaving(true);
              setError("");
              setSuccess("");

              try {
                const result =
                  await setBarberServiceStatus(
                    service.id,
                    !service.is_active
                  );

                if (mounted.current) {
                  applyResult(result);
                }
              } catch (err: unknown) {
                if (mounted.current) {
                  setError(errorMessage(err));
                }
              } finally {
                mutation.current = false;

                if (mounted.current) {
                  setSaving(false);
                }
              }
            })();
          },
        },
      ]
    );
  };

  // ==========================================================
  // RENDER
  // ==========================================================

  return (
    <SafeAreaView
      edges={["top", "left", "right"]}
      style={styles.screen}
    >
      {/* HEADER */}
      <View style={styles.header}>
        <Pressable
          onPress={onBack}
          disabled={saving}
          style={styles.headerButton}
        >
          <ArrowLeft size={20} color={C.text} />
        </Pressable>

        <View style={styles.flex}>
          <Text style={styles.headerEyebrow}>
            KSHURAK BARBER
          </Text>
          <Text style={styles.headerTitle}>
            Service Management
          </Text>
        </View>

        <Pressable
          disabled={busy}
          onPress={refresh}
          style={styles.headerButton}
        >
          {loading || refreshing ? (
            <ActivityIndicator
              size="small"
              color={GOLD}
            />
          ) : (
            <RefreshCw size={19} color={GOLD} />
          )}
        </Pressable>
      </View>

      {/* SERVICES LIST */}
      <FlatList
        data={visibleServices}
        keyExtractor={(item) => item.id}
        showsVerticalScrollIndicator={false}
        keyboardShouldPersistTaps="handled"
        refreshing={refreshing}
        onRefresh={refresh}
        contentContainerStyle={[
          styles.content,
          {
            paddingBottom: Math.max(
              30,
              insets.bottom + 24
            ),
          },
        ]}
        ListHeaderComponent={
          <View>
            {/* HERO */}
            <View style={styles.hero}>
              <View style={styles.heroTop}>
                <View style={styles.heroIcon}>
                  <Scissors size={25} color={GOLD} />
                </View>

                <View style={styles.heroBadge}>
                  <Sparkles size={13} color={GOLD} />
                  <Text style={styles.heroBadgeText}>
                    PREMIUM EXPERIENCE
                  </Text>
                </View>
              </View>

              <Text style={styles.heroTitle}>
                Your Signature{"\n"}
                <Text style={{ color: GOLD }}>
                  Service Collection
                </Text>
              </Text>

              <Text style={styles.heroDescription}>
                Curate your service menu, refine pricing
                and deliver a premium grooming experience
                to every customer.
              </Text>

              <Pressable
                disabled={busy}
                onPress={() => openEditor()}
                style={[
                  styles.heroButton,
                  busy && styles.disabled,
                ]}
              >
                <Plus size={18} color={BG} />

                <Text style={styles.heroButtonText}>
                  Create New Service
                </Text>

                <ArrowRight size={16} color={BG} />
              </Pressable>

              <View style={styles.heroDivider} />

              <View style={styles.heroFooter}>
                <ShieldCheck size={16} color={GOLD} />

                <Text style={styles.heroFooterText}>
                  Build a better customer experience
                  with a well-managed service catalogue.
                </Text>
              </View>
            </View>

            <Notice message={error} />
            <Notice message={success} success />

            {/* METRICS */}
            <View style={styles.sectionHeading}>
              <View style={styles.flex}>
                <Text style={styles.sectionEyebrow}>
                  BUSINESS OVERVIEW
                </Text>

                <Text style={styles.sectionTitle}>
                  Service Insights
                </Text>
              </View>
            </View>

            <View style={styles.metricGrid}>
              {metrics.map((item) => (
                <View
                  key={item.label}
                  style={{ width: metricWidth }}
                >
                  <MetricCard item={item} />
                </View>
              ))}
            </View>

            {/* DIRECTORY HEADER */}
            <View style={styles.sectionHeading}>
              <View style={styles.flex}>
                <Text style={styles.sectionEyebrow}>
                  YOUR CATALOGUE
                </Text>

                <Text style={styles.sectionTitle}>
                  Service Directory
                </Text>
              </View>

              <View style={styles.countBadge}>
                <Text style={styles.countText}>
                  {filtered.length}
                </Text>
              </View>
            </View>

            {/* FILTERS */}
            <View style={styles.filtersPanel}>
              <View style={styles.searchBox}>
                <Search size={17} color={MUTED} />

                <TextInput
                  style={styles.searchInput}
