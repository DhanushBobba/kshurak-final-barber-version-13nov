<file path="src/screens/reviews/ReviewsScreen.tsx">
import {
  useCallback,
  useEffect,
  useMemo,
  useRef,
  useState,
} from "react";
import {
  ActivityIndicator,
  FlatList,
  KeyboardAvoidingView,
  Modal,
  Platform,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
  useWindowDimensions,
} from "react-native";
import {
  SafeAreaView,
  useSafeAreaInsets,
} from "react-native-safe-area-context";
import { LinearGradient } from "expo-linear-gradient";
import {
  AlertCircle,
  ArrowLeft,
  CheckCheck,
  CheckCircle2,
  ChevronLeft,
  ChevronRight,
  Clock3,
  MessageCircle,
  MessageSquareText,
  RefreshCw,
  RotateCcw,
  Search,
  Send,
  ShieldCheck,
  Star,
  ThumbsUp,
  X,
} from "lucide-react-native";
import { COLORS } from "../../constants/colors";
import {
  getReviews,
  getReviewStatistics,
  saveReviewReply,
  type Review,
  type ReviewList,
  type ReviewStatistics,
  type ReviewSort,
} from "../../services/reviewsApi";

type Props = {
  onBack: () => void;
};

type RatingFilter = number | undefined;

const PAGE_SIZE = 5;

const SORT_OPTIONS: {
  value: ReviewSort;
  label: string;
}[] = [
  { value: "newest", label: "Newest" },
  { value: "oldest", label: "Oldest" },
  { value: "highest", label: "Highest" },
  { value: "lowest", label: "Lowest" },
];

function dateLabel(value: string): string {
  const date = new Date(value);
  if (!Number.isFinite(date.getTime())) {
    return "Date unavailable";
  }
  return date.toLocaleDateString("en-IN", {
    timeZone: "Asia/Kolkata",
    day: "numeric",
    month: "short",
    year: "numeric",
  });
}

function initials(name: string): string {
  return (
    name
      .trim()
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((part) => part.charAt(0).toUpperCase())
      .join("") || "C"
  );
}

function errorMessage(error: unknown): string {
  return error instanceof Error
    ? error.message
    : "Unable to load review information.";
}

function Stars({
  rating,
  size = 12,
}: {
  rating: number;
  size?: number;
}) {
  return (
    <View
      style={styles.stars}
      accessibilityLabel={`${rating} out of 5 stars`}
    >
      {[1, 2, 3, 4, 5].map((star) => (
        <Star
          key={star}
          size={size}
          color={
            star <= rating
              ? COLORS.primary
              : COLORS.borderLight
          }
          fill={
            star <= rating
              ? COLORS.primary
              : "transparent"
          }
        />
      ))}
    </View>
  );
}

function SmallButton({
  title,
  onPress,
  primary = false,
  disabled = false,
  icon,
}: {
  title: string;
  onPress: () => void;
  primary?: boolean;
  disabled?: boolean;
  icon?: React.ReactNode;
}) {
  return (
    <Pressable
      accessibilityRole="button"
      disabled={disabled}
      onPress={onPress}
      style={({ pressed }) => [
        styles.button,
        primary && styles.buttonPrimary,
        pressed && styles.buttonPressed,
        disabled && styles.disabled,
      ]}
    >
      {icon}
      <Text
        style={[
          styles.buttonLabel,
          primary && styles.buttonLabelPrimary,
        ]}
      >
        {title}
      </Text>
    </Pressable>
  );
}

function Notice({
  message,
  success = false,
  onDismiss,
}: {
  message: string;
  success?: boolean;
  onDismiss?: () => void;
}) {
  if (!message) return null;

  const color = success
    ? COLORS.success
    : COLORS.error;

  return (
    <View
      style={[
        styles.notice,
        {
          borderColor: success
            ? "rgba(34,197,94,0.35)"
            : "rgba(239,68,68,0.35)",
        },
      ]}
    >
      {success ? (
        <CheckCircle2 size={15} color={color} />
      ) : (
        <AlertCircle size={15} color={color} />
      )}
      <Text style={[styles.noticeText, { color }]}>
        {message}
      </Text>
      {onDismiss && (
        <Pressable
          accessibilityRole="button"
          accessibilityLabel="Dismiss notification"
          onPress={onDismiss}
        >
          <X size={15} color={color} />
        </Pressable>
      )}
    </View>
  );
}

function MetricCard({
  title,
  value,
  description,
  icon: Icon,
  width,
}: {
  title: string;
  value: string;
  description: string;
  icon: typeof Star;
  width: number | `${number}%`;
}) {
  return (
    <LinearGradient
      colors={[
        COLORS.surfaceLight,
        COLORS.surface,
        COLORS.surfaceDark,
      ]}
      start={{ x: 0, y: 0 }}
      end={{ x: 1, y: 1 }}
      style={[styles.metricCard, { width }]}
    >
      <View style={styles.metricTop}>
        <View style={styles.metricIcon}>
          <Icon size={16} color={COLORS.primary} />
        </View>
        <Text style={styles.metricTitle}>{title}</Text>
      </View>
      <Text
        style={styles.metricValue}
        numberOfLines={1}
        adjustsFontSizeToFit
      >
        {value}
      </Text>
      <Text style={styles.metricDescription}>
        {description}
      </Text>
    </LinearGradient>
  );
}

function ReviewCard({
  review,
  onReply,
  disabled,
}: {
  review: Review;
  onReply: (review: Review) => void;
  disabled: boolean;
}) {
  const hasReply = Boolean(review.reply?.trim());

  return (
    <View style={styles.reviewCard}>
      <View style={styles.reviewHeader}>
        <View style={styles.avatar}>
          <Text style={styles.avatarText}>
            {initials(review.customer_name || "Customer")}
          </Text>
        </View>
        <View style={styles.flex}>
          <Text
            style={styles.customerName}
            numberOfLines={1}
          >
            {review.customer_name || "Customer"}
          </Text>
          <View style={styles.reviewDateRow}>
            <Clock3 size={11} color={COLORS.textMuted} />
            <Text style={styles.reviewDate}>
              {dateLabel(review.created_at)}
            </Text>
          </View>
        </View>
        <View style={styles.ratingBadge}>
          <Star
            size={12}
            color={COLORS.primary}
            fill={COLORS.primary}
          />
          <Text style={styles.ratingBadgeText}>
            {review.rating.toFixed(1)}
          </Text>
        </View>
      </View>

      <View style={styles.reviewMeta}>
        <Stars rating={review.rating} />
        <View style={styles.serviceBadge}>
          <Text
            style={styles.serviceText}
            numberOfLines={1}
          >
            {review.service_name || "Service"}
          </Text>
        </View>
      </View>

      <Text style={styles.comment}>
        {review.comment?.trim() ||
          "Customer submitted a rating without a written comment."}
      </Text>

      {hasReply && (
        <View style={styles.replyPreview}>
          <View style={styles.replyPreviewTitle}>
            <CheckCheck
              size={13}
              color={COLORS.success}
            />
            <Text style={styles.replyPreviewLabel}>
              Your Response
            </Text>
            {review.barber_replied_at && (
              <Text style={styles.replyDate}>
                {dateLabel(review.barber_replied_at)}
              </Text>
            )}
          </View>
          <Text style={styles.replyPreviewText}>
            {review.reply}
          </Text>
        </View>
      )}

      <View style={styles.reviewFooter}>
        <View
          style={[
            styles.status,
            hasReply
              ? styles.statusReplied
              : styles.statusPending,
          ]}
        >
          {hasReply ? (
            <CheckCheck
              size={12}
              color={COLORS.success}
            />
          ) : (
            <MessageCircle
              size={12}
              color={COLORS.primary}
            />
          )}
          <Text
            style={[
              styles.statusText,
              {
                color: hasReply
                  ? COLORS.success
                  : COLORS.primary,
              },
            ]}
          >
            {hasReply ? "Replied" : "Awaiting Reply"}
          </Text>
        </View>
        <SmallButton
          title={hasReply ? "Edit Reply" : "Reply"}
          disabled={disabled}
          onPress={() => onReply(review)}
          icon={
            <MessageSquareText
              size={12}
              color={COLORS.text}
            />
          }
        />
      </View>
    </View>
  );
}

export default function ReviewsScreen({
  onBack,
}: Props) {
  const { width } = useWindowDimensions();
  const insets = useSafeAreaInsets();
  const mounted = useRef(true);
  const listRef = useRef<FlatList<Review>>(null);

  const [list, setList] = useState<ReviewList | null>(null);
  const [statistics, setStatistics] =
    useState<ReviewStatistics | null>(null);

  const [search, setSearch] = useState("");
  const [debouncedSearch, setDebouncedSearch] =
    useState("");
  const [serviceName, setServiceName] = useState("");
  const [debouncedService, setDebouncedService] =
    useState("");
  const [rating, setRating] =
    useState<RatingFilter>(undefined);
  const [sort, setSort] =
    useState<ReviewSort>("newest");
  const [page, setPage] = useState(1);

  const [refreshKey, setRefreshKey] = useState(0);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [statsLoading, setStatsLoading] = useState(true);
  const [error, setError] = useState("");
  const [statisticsError, setStatisticsError] =
    useState("");
  const [success, setSuccess] = useState("");

  const [replyReview, setReplyReview] =
    useState<Review | null>(null);
  const [replyText, setReplyText] = useState("");
  const [replyError, setReplyError] = useState("");
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    mounted.current = true;
    return () => {
      mounted.current = false;
    };
  }, []);

  useEffect(() => {
    const timer = setTimeout(() => {
      setDebouncedSearch(search.trim());
      setPage(1);
    }, 350);
    return () => clearTimeout(timer);
  }, [search]);

  useEffect(() => {
    const timer = setTimeout(() => {
      setDebouncedService(serviceName.trim());
      setPage(1);
    }, 350);
    return () => clearTimeout(timer);
  }, [serviceName]);

  const fetchReviews = useCallback(() => {
    const controller = new AbortController();
    setLoading(true);
    setError("");

    void getReviews(
      {
        search: debouncedSearch || undefined,
        serviceName: debouncedService || undefined,
        rating,
        sort,
        limit: PAGE_SIZE,
        offset: (page - 1) * PAGE_SIZE,
      },
      controller.signal
    )
      .then((result) => {
        if (controller.signal.aborted || !mounted.current) {
          return;
        }
        setList(result);
        if (
          page > 1 &&
          result.total <= (page - 1) * PAGE_SIZE
        ) {
          setPage(
            Math.max(
              1,
              Math.ceil(result.total / PAGE_SIZE)
            )
          );
        }
      })
      .catch((reason: unknown) => {
        if (controller.signal.aborted || !mounted.current) {
          return;
        }
        setList(null);
        setError(errorMessage(reason));
      })
      .finally(() => {
        if (!controller.signal.aborted && mounted.current) {
          setLoading(false);
          setRefreshing(false);
        }
      });

    return () => controller.abort();
  }, [
    debouncedSearch,
    debouncedService,
    rating,
    sort,
    page,
  ]);

  useEffect(() => {
    return fetchReviews();
  }, [fetchReviews, refreshKey]);

  useEffect(() => {
    const controller = new AbortController();
    setStatsLoading(true);
    setStatisticsError("");

    void getReviewStatistics(controller.signal)
      .then((result) => {
        if (!controller.signal.aborted && mounted.current) {
          setStatistics(result);
        }
      })
      .catch((reason: unknown) => {
        if (!controller.signal.aborted && mounted.current) {
          setStatisticsError(errorMessage(reason));
        }
      })
      .finally(() => {
        if (!controller.signal.aborted && mounted.current) {
          setStatsLoading(false);
        }
      });

    return () => controller.abort();
  }, [refreshKey]);

  const refresh = useCallback(() => {
    if (saving) return;
    setSuccess("");
    setRefreshing(true);
    setRefreshKey((value) => value + 1);
  }, [saving]);

  const changeRating = useCallback(
    (value: RatingFilter) => {
      if (saving) return;
      setRating(value);
      setPage(1);
    },
    [saving]
  );

  const changeSort = useCallback(
    (value: ReviewSort) => {
      if (saving) return;
      setSort(value);
      setPage(1);
    },
    [saving]
  );

  const resetFilters = useCallback(() => {
    setSearch("");
    setDebouncedSearch("");
    setServiceName("");
    setDebouncedService("");
    setRating(undefined);
    setSort("newest");
    setPage(1);
  }, []);

  const openReply = useCallback((review: Review) => {
    setReplyReview(review);
    setReplyText(review.reply || "");
    setReplyError("");
  }, []);

  const closeReply = useCallback(() => {
    if (saving) return;
    setReplyReview(null);
    setReplyText("");
    setReplyError("");
  }, [saving]);

  const submitReply = async () => {
    if (!replyReview || saving) return;
    const cleaned = replyText.trim();

    if (!cleaned || cleaned.length > 3000) {
      setReplyError(
        "Enter a reply between 1 and 3000 characters."
      );
      return;
    }

    setSaving(true);
    setReplyError("");

    try {
      const response = await saveReviewReply(
        replyReview.id,
        cleaned
      );

      if (response.review.id !== replyReview.id) {
        throw new Error(
          "The saved reply could not be verified."
        );
      }

      if (!mounted.current) return;

      setList((previous) =>
        previous
          ? {
              ...previous,
              reviews: previous.reviews.map((item) =>
                item.id === response.review.id
                  ? response.review
                  : item
              ),
            }
          : previous
      );

      setReplyReview(null);
      setReplyText("");
      setSuccess(
        response.message ||
          "Your response has been saved successfully."
      );
      setRefreshKey((value) => value + 1);
    } catch (reason: unknown) {
      if (mounted.current) {
        setReplyError(errorMessage(reason));
      }
    } finally {
      if (mounted.current) {
        setSaving(false);
      }
    }
  };

  const metrics = useMemo(
    () => [
      {
        title: "Average Rating",
        value: statsLoading && !statistics
          ? "..."
          : statistics?.average_rating == null
            ? "—"
            : `${statistics.average_rating.toFixed(1)}/5`,
        description: "Overall satisfaction",
        icon: Star,
      },
      {
        title: "Total Reviews",
        value: statsLoading && !statistics
          ? "..."
          : String(statistics?.total_reviews ?? 0),
        description: "Customer feedback",
        icon: MessageSquareText,
      },
      {
        title: "5-Star Reviews",
        value: statsLoading && !statistics
          ? "..."
          : String(statistics?.five_star_reviews ?? 0),
        description: "Top-rated visits",
        icon: ThumbsUp,
      },
      {
        title: "Response Rate",
        value: statsLoading && !statistics
          ? "..."
          : statistics?.response_rate == null
            ? "—"
            : `${statistics.response_rate.toFixed(0)}%`,
        description: "Reviews answered",
        icon: CheckCheck,
      },
    ],
    [statistics, statsLoading]
  );

  const distribution = useMemo(
    () =>
      [5, 4, 3, 2, 1].map((value) => {
        const result = statistics?.rating_distribution.find(
          (item) => item.rating === value
        );
        return {
          rating: value,
          count: result?.count ?? 0,
          percentage: result?.percentage ?? 0,
        };
      }),
    [statistics]
  );

  const total = list?.total ?? 0;
  const pages = Math.max(
    1,
    Math.ceil(total / PAGE_SIZE)
  );
  const from =
    total === 0 ? 0 : (page - 1) * PAGE_SIZE + 1;
  const to = Math.min(page * PAGE_SIZE, total);
  const metricWidth: `${number}%` =
    width < 340 ? "100%" : width >= 760 ? "23.5%" : "48.5%";

  const hasFilters =
    Boolean(debouncedSearch) ||
    Boolean(debouncedService) ||
    rating !== undefined;

  const header = (
    <View>
      <View style={styles.introduction}>
        <Text style={styles.eyebrow}>
          CUSTOMER EXPERIENCE
        </Text>
        <Text style={styles.pageTitle}>
          Reviews & Ratings
        </Text>
        <Text style={styles.subtitle}>
          Understand customer satisfaction and respond
          to feedback from your shop.
        </Text>
      </View>

      <Notice
        message={success}
        success
        onDismiss={() => setSuccess("")}
      />
      <Notice message={statisticsError} />

      <View style={styles.metrics}>
        {metrics.map((metric) => (
          <MetricCard
            key={metric.title}
            title={metric.title}
            value={metric.value}
            description={metric.description}
            icon={metric.icon}
            width={metricWidth}
          />
        ))}
      </View>

      <View style={styles.distributionPanel}>
        <View style={styles.panelHeader}>
          <View style={styles.flex}>
            <Text style={styles.sectionTitle}>
              Rating Distribution
            </Text>
            <Text style={styles.panelSubtitle}>
              Breakdown of customer ratings
            </Text>
          </View>
          <View style={styles.countBadge}>
            <Star
              size={11}
              color={COLORS.primary}
            />
            <Text style={styles.countBadgeText}>
              {statistics?.total_reviews ?? 0}
            </Text>
          </View>
        </View>

        {distribution.map((item) => {
          const selected = rating === item.rating;
          return (
            <Pressable
              key={item.rating}
              accessibilityRole="button"
              accessibilityLabel={`Filter ${item.rating}-star reviews`}
              disabled={saving}
              onPress={() =>
                changeRating(
                  selected ? undefined : item.rating
                )
              }
              style={({ pressed }) => [
                styles.distributionRow,
                selected && styles.distributionSelected,
                pressed && styles.buttonPressed,
              ]}
            >
              <View style={styles.distributionLabel}>
                <Text style={styles.distributionRating}>
                  {item.rating}
                </Text>
                <Star
                  size={11}
                  color={COLORS.primary}
                  fill={COLORS.primary}
                />
              </View>
              <View style={styles.track}>
                <View
                  style={[
                    styles.trackFill,
                    {
                      width: `${Math.max(
                        0,
                        Math.min(100, item.percentage)
                      )}%`,
                    },
                  ]}
                />
              </View>
              <Text style={styles.distributionCount}>
                {item.count}
              </Text>
            </Pressable>
          );
        })}
      </View>

      <View style={styles.filterPanel}>
        <View style={styles.panelHeader}>
          <View>
            <Text style={styles.sectionTitle}>
              Customer Reviews
            </Text>
            <Text style={styles.panelSubtitle}>
              {total} matching reviews
            </Text>
          </View>
          <View style={styles.countBadge}>
            <MessageSquareText
              size={12}
              color={COLORS.primary}
            />
            <Text style={styles.countBadgeText}>
              {statistics?.total_reviews ?? 0}
            </Text>
          </View>
        </View>

        <View style={styles.searchContainer}>
          <Search
            size={15}
            color={COLORS.primary}
          />
          <TextInput
            value={search}
            onChangeText={setSearch}
            editable={!saving}
            maxLength={150}
            autoCorrect={false}
            placeholder="Search customer, review or service..."
            placeholderTextColor={COLORS.textMuted}
            style={styles.searchInput}
            accessibilityLabel="Search customer reviews"
          />
          {search.length > 0 && (
            <Pressable
              accessibilityRole="button"
              accessibilityLabel="Clear search"
              onPress={() => setSearch("")}
            >
              <X size={14} color={COLORS.textMuted} />
            </Pressable>
          )}
        </View>

        <TextInput
          value={serviceName}
          onChangeText={setServiceName}
          editable={!saving}
          maxLength={150}
          placeholder="Filter by exact service name (optional)"
          placeholderTextColor={COLORS.textMuted}
          accessibilityLabel="Filter by service name"
          style={styles.serviceInput}
        />

        <Text style={styles.filterCaption}>
          Filter by rating
        </Text>
        <ScrollView
          horizontal
          showsHorizontalScrollIndicator={false}
          contentContainerStyle={styles.chipRow}
          keyboardShouldPersistTaps="handled"
        >
          {[undefined, 5, 4, 3, 2, 1].map((value) => (
            <SmallButton
              key={value ?? "all"}
              title={
                value === undefined
                  ? "All"
                  : `${value} ★`
              }
              primary={rating === value}
              disabled={saving}
              onPress={() => changeRating(value)}
            />
          ))}
        </ScrollView>

        <Text style={styles.filterCaption}>
          Sort reviews
        </Text>
        <ScrollView
          horizontal
          showsHorizontalScrollIndicator={false}
          contentContainerStyle={styles.chipRow}
          keyboardShouldPersistTaps="handled"
        >
          {SORT_OPTIONS.map((option) => (
            <SmallButton
              key={option.value}
              title={option.label}
              primary={sort === option.value}
              disabled={saving}
              onPress={() => changeSort(option.value)}
            />
          ))}
        </ScrollView>

        <View style={styles.filterFooter}>
          <SmallButton
            title="Reset Filters"
            disabled={saving}
            onPress={resetFilters}
            icon={
              <RotateCcw
                size={12}
                color={COLORS.text}
              />
            }
          />
        </View>
      </View>

      <Notice message={error} />
      <View style={styles.listHeading}>
        <Text style={styles.sectionTitle}>
          Customer Feedback
        </Text>
        <Text style={styles.panelSubtitle}>
          {from}–{to} of {total}
        </Text>
      </View>
    </View>
  );

  return (
    <SafeAreaView
      style={styles.screen}
      edges={["top", "bottom", "left", "right"]}
    >
      <View style={styles.topbar}>
        <Pressable
          accessibilityRole="button"
          accessibilityLabel="Back to dashboard"
          onPress={onBack}
          style={styles.iconButton}
        >
          <ArrowLeft size={18} color={COLORS.text} />
        </Pressable>
        <View style={styles.flex}>
          <Text style={styles.topbarEyebrow}>
            KSHURAK BARBER
          </Text>
          <Text style={styles.topbarTitle}>
            Reviews & Ratings
          </Text>
        </View>
        <Pressable
          accessibilityRole="button"
          accessibilityLabel="Refresh reviews"
          disabled={saving || loading || statsLoading}
          onPress={refresh}
          style={[
            styles.iconButton,
            (saving || loading) && styles.disabled,
          ]}
        >
          {loading || refreshing || statsLoading ? (
            <ActivityIndicator
              size="small"
              color={COLORS.primary}
            />
          ) : (
            <RefreshCw
              size={17}
              color={COLORS.primary}
            />
          )}
        </Pressable>
      </View>

      <FlatList
        ref={listRef}
        data={loading ? [] : list?.reviews ?? []}
        keyExtractor={(item) => item.id}
        renderItem={({ item }) => (
          <ReviewCard
            review={item}
            disabled={saving}
            onReply={openReply}
          />
        )}
        ListHeaderComponent={header}
        contentContainerStyle={styles.content}
        keyboardShouldPersistTaps="handled"
        showsVerticalScrollIndicator={false}
        refreshing={refreshing}
        onRefresh={refresh}
        ListEmptyComponent={
          <View style={styles.empty}>
            {loading ? (
              <>
                <ActivityIndicator
                  size="large"
                  color={COLORS.primary}
                />
                <Text style={styles.emptyTitle}>
                  Loading reviews...
                </Text>
              </>
            ) : (
              <>
                <MessageSquareText
                  size={26}
                  color={COLORS.primary}
                />
                <Text style={styles.emptyTitle}>
                  {error
                    ? "Unable to Load Reviews"
                    : hasFilters
                      ? "No Matching Reviews"
                      : "No Reviews Yet"}
                </Text>
                <Text style={styles.emptyDescription}>
                  {error
                    ? "Please refresh and try again."
                    : hasFilters
                      ? "Adjust your search or filter settings."
                      : "Customer feedback will appear when completed appointments are reviewed."}
                </Text>
                {hasFilters && (
                  <SmallButton
                    title="Reset Filters"
                    onPress={resetFilters}
                  />
                )}
              </>
            )}
          </View>
        }
        ListFooterComponent={
          <View>
            <View style={styles.pagination}>
              <Text style={styles.paginationText}>
                Page {page} of {pages}
              </Text>
              <View style={styles.paginationActions}>
                <Pressable
                  accessibilityRole="button"
                  accessibilityLabel="Previous reviews page"
                  disabled={page <= 1 || loading || saving}
                  onPress={() =>
                    setPage((value) => Math.max(1, value - 1))
                  }
                  style={[
                    styles.paginationButton,
                    (page <= 1 || loading || saving) &&
                      styles.disabled,
                  ]}
                >
                  <ChevronLeft
                    size={17}
                    color={COLORS.text}
                  />
                </Pressable>
                <Pressable
                  accessibilityRole="button"
                  accessibilityLabel="Next reviews page"
                  disabled={
                    page >= pages || loading || saving
                  }
                  onPress={() =>
                    setPage((value) =>
                      Math.min(pages, value + 1)
                    )
                  }
                  style={[
                    styles.paginationButton,
                    (page >= pages || loading || saving) &&
                      styles.disabled,
                  ]}
                >
                  <ChevronRight
                    size={17}
                    color={COLORS.text}
                  />
                </Pressable>
              </View>
            </View>
            <View style={styles.securityNote}>
              <ShieldCheck
                size={14}
                color={COLORS.success}
              />
              <Text style={styles.securityText}>
                Reviews are retrieved for your authenticated shop.
              </Text>
            </View>
          </View>
        }
      />

      <Modal
        visible={replyReview !== null}
        transparent
        animationType="slide"
        onRequestClose={closeReply}
      >
        <KeyboardAvoidingView
          behavior={
            Platform.OS === "ios" ? "padding" : "height"
          }
          style={[
            styles.modalOverlay,
            {
              paddingTop: Math.max(16, insets.top),
              paddingBottom: Math.max(16, insets.bottom),
            },
          ]}
        >
          <View style={styles.modalSheet}>
            <View style={styles.modalHeader}>
              <View style={styles.flex}>
