}

// ============================================================
// MAIN SCREEN
// ============================================================

export default function NotificationsScreen({
  onBack,
  onNavigate,
}: Props) {
  const focused = useIsFocused();
  const insets = useSafeAreaInsets();
  const { width } = useWindowDimensions();

  const [card, setCard] =
    useState<CardType>("all");

  const [offset, setOffset] = useState(0);

  const [notifications, setNotifications] =
    useState<BarberNotification[]>([]);

  const [counts, setCounts] =
    useState<NotificationCounts>(EMPTY_COUNTS);

  const [total, setTotal] = useState(0);
  const [search, setSearch] = useState("");

  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [saving, setSaving] = useState(false);

  const [loaded, setLoaded] = useState(false);
  const [loadedKey, setLoadedKey] = useState("");

  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");

  const [reload, setReload] = useState(0);

  const [detail, setDetail] =
    useState<BarberNotification | null>(null);

  const mounted = useRef(false);
  const focusedRef = useRef(focused);
  const actionBusy = useRef(false);
  const fetching = useRef(false);
  const version = useRef(0);

  const controller =
    useRef<AbortController | null>(null);

  const list =
    useRef<FlatList<BarberNotification>>(null);

  focusedRef.current = focused;

  const queryKey = `${card}:${offset}`;
  const currentPageLoaded = loadedKey === queryKey;
  const busy = loading || refreshing || saving;

  // ==========================================================
  // LOAD NOTIFICATIONS
  // ==========================================================

  const load = useCallback(
    async (
      mode: "initial" | "refresh" | "poll" = "initial"
    ) => {
      if (
        !mounted.current ||
        !focusedRef.current ||
        actionBusy.current
      ) {
        return;
      }

      if (mode === "poll" && fetching.current) {
        return;
      }

      const current = ++version.current;

      controller.current?.abort();

      const abort = new AbortController();
      controller.current = abort;
      fetching.current = true;

      if (mode === "initial") {
        setLoading(true);
        setRefreshing(false);
      } else if (mode === "refresh") {
        setRefreshing(true);
        setLoading(false);
      }

      try {
        const category: NotificationCategory =
          card === "booking" ||
          card === "rescheduling"
            ? card
            : "all";

        const response = await getNotifications(
          {
            category,
            unreadOnly: card === "unread",
            limit: PAGE_SIZE,
            offset,
          },
          abort.signal
        );

        if (
          !mounted.current ||
          abort.signal.aborted ||
          current !== version.current
        ) {
          return;
        }

        const lastOffset =
          response.total > 0
            ? Math.floor(
                (response.total - 1) / PAGE_SIZE
              ) * PAGE_SIZE
            : 0;

        if (offset > lastOffset) {
          setOffset(lastOffset);
          return;
        }

        setNotifications(response.notifications);
        setCounts(response.counts);
        setTotal(response.total);

        setLoaded(true);
        setLoadedKey(`${card}:${offset}`);
        setError("");
      } catch (err: unknown) {
        if (
          mounted.current &&
          !abort.signal.aborted &&
          current === version.current
        ) {
          setError(messageOf(err));
        }
      } finally {
        if (
          mounted.current &&
          current === version.current
        ) {
          fetching.current = false;
          setLoading(false);
          setRefreshing(false);
        }
      }
    },
    [card, offset]
  );

  // ==========================================================
  // MOUNT / UNMOUNT
  // ==========================================================

  useEffect(() => {
    mounted.current = true;

    return () => {
      mounted.current = false;
      version.current += 1;
      controller.current?.abort();
    };
  }, []);

  // ==========================================================
  // AUTO REFRESH
  // ==========================================================

  useEffect(() => {
    if (!focused) return;

    void load("initial");

    const interval = setInterval(() => {
      if (
        AppState.currentState === "active" &&
        !actionBusy.current
      ) {
        void load("poll");
      }
    }, POLL_INTERVAL);

    const subscription = AppState.addEventListener(
      "change",
      (state) => {
        if (
          state === "active" &&
          focusedRef.current &&
          !actionBusy.current &&
          !fetching.current
        ) {
          void load("poll");
        }
      }
    );

    return () => {
      clearInterval(interval);
      subscription.remove();
      version.current += 1;
      controller.current?.abort();
      fetching.current = false;
    };
  }, [focused, load, reload]);

  // ==========================================================
  // FILTER SEARCH
  // ==========================================================

  const visibleNotifications = useMemo(() => {
    if (!currentPageLoaded) return [];

    const query = search.trim().toLowerCase();

    if (!query) return notifications;

    return notifications.filter((item) =>
      [
        item.title,
        item.message,
        getCategory(item),
      ].some((value) =>
        String(value)
          .toLowerCase()
          .includes(query)
      )
    );
  }, [
    notifications,
    search,
    currentPageLoaded,
  ]);

  // ==========================================================
  // REFRESH
  // ==========================================================

  const refresh = () => {
    if (actionBusy.current || fetching.current) {
      return;
    }

    setSuccess("");
    void load("refresh");
  };

  // ==========================================================
  // CHANGE CATEGORY
  // ==========================================================

  const changeCard = (next: CardType) => {
    if (next === card || actionBusy.current) {
      return;
    }

    version.current += 1;
    controller.current?.abort();
    fetching.current = false;

    setLoading(true);
    setCard(next);
    setOffset(0);
    setSearch("");
    setSuccess("");
    setError("");

    list.current?.scrollToOffset({
      offset: 0,
      animated: true,
    });
  };

  // ==========================================================
  // CHANGE PAGE
  // ==========================================================

  const changePage = (next: number) => {
    if (busy || !currentPageLoaded) return;

    version.current += 1;
    controller.current?.abort();
    fetching.current = false;

    setLoading(true);
    setOffset(next);
    setSearch("");
    setSuccess("");
    setError("");

    list.current?.scrollToOffset({
      offset: 0,
      animated: true,
    });
  };

  // ==========================================================
  // CANCEL IN-FLIGHT FETCH BEFORE A MUTATION
  // ==========================================================

  const stopOldFetch = () => {
    version.current += 1;
    controller.current?.abort();
    fetching.current = false;
    setLoading(false);
    setRefreshing(false);
  };

  // ==========================================================
  // MARK SINGLE NOTIFICATION READ
  // ==========================================================

  const markOneRead = async (
    item: BarberNotification,
    showMessage = true
  ): Promise<boolean> => {
    if (actionBusy.current) return false;
    if (item.is_read) return true;

    actionBusy.current = true;

    stopOldFetch();

    setSaving(true);
    setError("");
    setSuccess("");

    try {
      const result =
        await markNotificationAsRead(item.id);

      if (!mounted.current) {
        return false;
      }

      setNotifications((previous) =>
        previous.map((notification) =>
          notification.id === result.notification.id
            ? result.notification
            : notification
        )
      );

      setDetail((previous) =>
        previous?.id === result.notification.id
          ? result.notification
          : previous
      );

      setCounts((previous) => ({
        ...previous,
        unread: Math.max(0, previous.unread - 1),
      }));

      if (card === "unread") {
        setNotifications((previous) =>
          previous.filter(
            (notification) =>
              notification.id !== item.id
          )
        );

        setTotal((previous) =>
          Math.max(0, previous - 1)
        );

        setOffset(0);
      }

      if (showMessage) {
        setSuccess(
          result.message ||
            "Notification marked as read."
        );
      }

      return true;
    } catch (err: unknown) {
      if (mounted.current) {
        setError(messageOf(err));
      }

      return false;
    } finally {
      actionBusy.current = false;

      if (mounted.current) {
        setSaving(false);
        setReload((value) => value + 1);
      }
    }
  };

  // ==========================================================
  // OPEN NOTIFICATION
  // ==========================================================

  const openNotification = async (
    item: BarberNotification
  ) => {
    if (actionBusy.current) return;

    const destination = getDestination(item);

    const updated = await markOneRead(
      item,
      false
    );

    if (
      !updated ||
      !mounted.current ||
      !focusedRef.current
    ) {
      return;
    }

    if (destination) {
      onNavigate(destination);
    } else {
      setDetail({
        ...item,
        is_read: true,
      });
    }
  };

  // ==========================================================
  // MARK ALL AS READ
  // ==========================================================

  const performMarkAll = async () => {
    if (
      actionBusy.current ||
      counts.unread <= 0
    ) {
      return;
    }

    actionBusy.current = true;

    stopOldFetch();

    setSaving(true);
    setError("");
    setSuccess("");

    try {
      const result =
        await markAllNotificationsAsRead();

      if (!mounted.current) return;

      setCounts((previous) => ({
        ...previous,
        unread: result.unread_count,
      }));

      setNotifications((previous) =>
        card === "unread"
          ? []
          : previous.map((item) => ({
              ...item,
              is_read: true,
            }))
      );

      if (card === "unread") {
        setTotal(0);
        setOffset(0);
      }

      setSuccess(
        `${result.updated_count} notification${
          result.updated_count === 1
            ? ""
            : "s"
        } marked as read.`
      );
    } catch (err: unknown) {
      if (mounted.current) {
        setError(messageOf(err));
      }
    } finally {
      actionBusy.current = false;

      if (mounted.current) {
        setSaving(false);
        setReload((value) => value + 1);
      }
    }
  };

  const confirmMarkAll = () => {
    if (
      busy ||
      counts.unread <= 0
    ) {
      return;
    }

    Alert.alert(
      "Mark All Notifications as Read?",
      "This will mark every unread notification as read, including bookings and rescheduling alerts.",
      [
        {
          text: "Cancel",
          style: "cancel",
        },
        {
          text: "Mark All Read",
          onPress: () => {
            void performMarkAll();
          },
        },
      ]
    );
  };

  // ==========================================================
  // PAGINATION
  // ==========================================================

  const page =
    Math.floor(offset / PAGE_SIZE) + 1;

  const pages = Math.max(
    1,
    Math.ceil(total / PAGE_SIZE)
  );

  const metricWidth =
    width < 340
      ? "100%"
      : width >= 760
      ? "23.5%"
      : "48.5%";

  // ==========================================================
  // MAIN UI
  // ==========================================================

  return (
    <SafeAreaView
      edges={["top", "left", "right"]}
      style={styles.container}
    >
      {/* HEADER */}

      <View style={styles.topbar}>
        <Pressable
          accessibilityRole="button"
          accessibilityLabel="Back to dashboard"
          disabled={saving}
          onPress={onBack}
          style={styles.iconButton}
        >
          <ArrowLeft
            size={20}
            color={C.text}
          />
        </Pressable>

        <View style={styles.flex}>
          <Text style={styles.eyebrow}>
            KSHURAK BARBER
          </Text>

          <Text style={styles.topbarTitle}>
            Notifications
          </Text>
        </View>

        <Pressable
          accessibilityRole="button"
          accessibilityLabel="Refresh notifications"
          disabled={busy}
          onPress={refresh}
          style={[
            styles.iconButton,
            busy && styles.disabled,
          ]}
        >
          {loading || refreshing ? (
            <ActivityIndicator
              size="small"
              color={GOLD}
            />
          ) : (
            <RefreshCw
              size={19}
              color={GOLD}
            />
          )}
        </Pressable>
      </View>

      <FlatList
        ref={list}
        data={visibleNotifications}
        keyExtractor={(item) => item.id}
        showsVerticalScrollIndicator={false}
        keyboardShouldPersistTaps="handled"
        refreshing={refreshing}
        onRefresh={refresh}
        initialNumToRender={8}
        contentContainerStyle={[
          styles.content,
          {
            paddingBottom: Math.max(
              28,
              insets.bottom + 25
            ),
          },
        ]}
        renderItem={({ item }) => (
          <NotificationCard
            item={item}
            disabled={saving}
            onMarkRead={(notification) => {
              void markOneRead(notification);
            }}
            onOpen={(notification) => {
              void openNotification(notification);
            }}
          />
        )}
        ItemSeparatorComponent={() => (
          <View style={{ height: 12 }} />
        )}
        ListHeaderComponent={
          <View>
            {/* PREMIUM HERO */}

            <View style={styles.hero}>
              <View style={styles.heroTop}>
                <View style={styles.heroIcon}>
                  <BellRing
                    size={26}
                    color={GOLD}
                  />
                </View>

                <View style={styles.heroBadge}>
                  <Sparkles
                    size={13}
                    color={GOLD}
                  />

                  <Text style={styles.heroBadgeText}>
                    ACTIVITY CENTER
                  </Text>
                </View>
              </View>

              <Text style={styles.heroTitle}>
                Stay Informed.
                {"\n"}
                <Text style={styles.heroGold}>
                  Stay Ahead.
                </Text>
              </Text>

              <Text style={styles.heroDescription}>
                Track booking confirmations,
                appointment changes and important
                shop notifications in one place.
              </Text>

              <View style={styles.heroFooter}>
                <View style={styles.heroMetric}>
                  <Text style={styles.heroMetricValue}>
                    {loaded ? counts.total : "—"}
                  </Text>

                  <Text style={styles.heroMetricLabel}>
                    TOTAL ALERTS
                  </Text>
                </View>

                <View style={styles.heroMetricDivider} />

                <View style={styles.heroMetric}>
                  <Text
                    style={[
                      styles.heroMetricValue,
                      { color: GOLD },
                    ]}
                  >
                    {loaded ? counts.unread : "—"}
                  </Text>

                  <Text style={styles.heroMetricLabel}>
                    UNREAD
                  </Text>
                </View>

                <View style={styles.heroMetricDivider} />

                <View style={styles.heroMetric}>
                  <Text style={styles.heroMetricValue}>
                    {loaded
                      ? counts.booking +
                        counts.rescheduling
                      : "—"}
                  </Text>

                  <Text style={styles.heroMetricLabel}>
                    APPOINTMENT ALERTS
                  </Text>
                </View>
              </View>
            </View>

            {/* MARK ALL READ */}

            <View style={styles.quickAction}>
              <View style={styles.quickActionIcon}>
                <CheckCheck
                  size={21}
                  color={GOLD}
                />
              </View>

              <View style={styles.flex}>
                <Text style={styles.quickActionTitle}>
                  Clear Unread Alerts
                </Text>

                <Text style={styles.quickActionSubtitle}>
                  Mark your notifications as read
                </Text>
              </View>
            </View>

            <Button
              title={
                saving
                  ? "Updating..."
                  : "Mark All as Read"
              }
              disabled={
                busy ||
                !loaded ||
                counts.unread <= 0
              }
              busy={saving}
              icon={
                <CheckCheck
                  size={16}
                  color={GOLD}
                />
              }
              onPress={confirmMarkAll}
            />

            <View style={styles.noticeArea}>
              <Notice text={error} />
              <Notice text={success} success />
            </View>

            {/* SUMMARY CARDS */}

            <View style={styles.sectionHeading}>
              <View>
                <Text style={styles.sectionEyebrow}>
                  LIVE ACTIVITY
                </Text>

                <Text style={styles.sectionTitle}>
                  Notification Insights
                </Text>
              </View>

              <View style={styles.sectionIcon}>
                <Bell
                  size={17}
                  color={GOLD}
                />
              </View>
            </View>

            <View style={styles.summaryGrid}>
              {SUMMARY_CARDS.map((item) => (
                <View
                  key={item.key}
                  style={{
                    width: metricWidth,
                  }}
                >
                  <PremiumSummaryCard
                    item={item}
                    count={
                      loaded
                        ? getCount(item.key, counts)
                        : "—"
                    }
                    active={card === item.key}
                    disabled={saving}
                    onPress={() =>
                      changeCard(item.key)
                    }
                  />
                </View>
              ))}
            </View>

            {/* NOTIFICATION RECORDS */}

            <View style={styles.sectionHeading}>
              <View>
                <Text style={styles.sectionEyebrow}>
                  ACTIVITY HISTORY
                </Text>

                <Text style={styles.sectionTitle}>
                  {
                    SUMMARY_CARDS.find(
                      (item) => item.key === card
                    )?.title
                  }
                </Text>
              </View>

              <View style={styles.countBadge}>
                <Text style={styles.countBadgeText}>
                  {currentPageLoaded ? total : "—"}
                </Text>
              </View>
            </View>

            <View style={styles.searchBox}>
              <Search
                size={18}
                color={MUTED}
              />

              <TextInput
                accessibilityLabel="Search notifications on the current page"
                value={search}
                onChangeText={setSearch}
                placeholder="Search notifications..."
                placeholderTextColor={C.textMuted}
                selectionColor={GOLD}
                autoCorrect={false}
                style={styles.searchInput}
              />

              {!!search && (
                <Pressable
                  accessibilityRole="button"
                  accessibilityLabel="Clear search"
                  onPress={() => setSearch("")}
                >
                  <X
                    size={17}
                    color={MUTED}
                  />
                </Pressable>
              )}
            </View>

            <View style={styles.listHeading}>
              <Text style={styles.listHeadingText}>
                Recent Activity
              </Text>

              <View style={styles.liveBadge}>
                <View style={styles.liveDot} />

                <Text style={styles.liveText}>
                  AUTO REFRESH
                </Text>
              </View>
            </View>
          </View>
        }
        ListEmptyComponent={
          <View style={styles.emptyCard}>
            {loading && !currentPageLoaded ? (
              <>
                <ActivityIndicator
                  size="large"
                  color={GOLD}
                />

                <Text style={styles.emptyTitle}>
