              </View>

              <ScrollView
                horizontal
                showsHorizontalScrollIndicator={false}
                contentContainerStyle={styles.categoryRow}
              >
                {CATEGORIES.map((item) => {
                  const active = category === item.key;

                  return (
                    <Pressable
                      key={item.key}
                      disabled={saving}
                      onPress={() =>
                        setCategory(item.key)
                      }
                      style={[
                        styles.categoryChip,
                        active &&
                          styles.categoryChipActive,
                      ]}
                    >
                      <Text
                        style={[
                          styles.categoryText,
                          active &&
                            styles.categoryTextActive,
                        ]}
                      >
                        {item.title}
                      </Text>
                    </Pressable>
                  );
                })}
              </ScrollView>
            </View>

            {/* RESULTS */}
            <View style={styles.resultsHeader}>
              <Text style={styles.resultsTitle}>
                Available Services
              </Text>

              <Text style={styles.resultsSubtitle}>
                {filtered.length} result
                {filtered.length === 1 ? "" : "s"}
              </Text>
            </View>
          </View>
        }
        ItemSeparatorComponent={() => (
          <View style={{ height: 12 }} />
        )}
        ListEmptyComponent={
          <View style={styles.emptyCard}>
            {loading && !loaded ? (
              <>
                <ActivityIndicator
                  size="large"
                  color={GOLD}
                />
                <Text style={styles.emptyTitle}>
                  Loading Services
                </Text>
              </>
            ) : (
              <>
                <View style={styles.emptyIcon}>
                  <Scissors size={29} color={GOLD} />
                </View>

                <Text style={styles.emptyTitle}>
                  {error
                    ? "Unable to Load Services"
                    : "No Services Found"}
                </Text>

                <Text style={styles.emptyDescription}>
                  {error
                    ? "Check your internet connection and try again."
                    : "No services match the selected filters."}
                </Text>

                <ActionButton
                  title="Refresh"
                  icon={RefreshCw}
                  onPress={refresh}
                  disabled={busy}
                />
              </>
            )}
          </View>
        }
        renderItem={({ item }) => (
          <ServiceCard
            service={item}
            saving={busy}
            onEdit={openEditor}
            onToggle={toggleService}
          />
        )}
        ListFooterComponent={
          filtered.length > 0 ? (
            <View style={styles.pagination}>
              <View style={styles.paginationHeader}>
                <Text style={styles.paginationText}>
                  Page {currentPage + 1} of {totalPages}
                </Text>

                <Text style={styles.paginationText}>
                  {filtered.length} services
                </Text>
              </View>

              <View style={styles.paginationButtons}>
                <Pressable
                  disabled={busy || currentPage === 0}
                  onPress={() =>
                    setPage((value) =>
                      Math.max(0, value - 1)
                    )
                  }
                  style={[
                    styles.pageButton,
                    (busy || currentPage === 0) &&
                      styles.disabled,
                  ]}
                >
                  <ChevronLeft
                    size={16}
                    color={GOLD}
                  />
                  <Text style={styles.pageText}>
                    Previous
                  </Text>
                </Pressable>

                <Pressable
                  disabled={
                    busy ||
                    currentPage >= totalPages - 1
                  }
                  onPress={() =>
                    setPage((value) =>
                      Math.min(totalPages - 1, value + 1)
                    )
                  }
                  style={[
                    styles.pageButton,
                    (busy ||
                      currentPage >= totalPages - 1) &&
                      styles.disabled,
                  ]}
                >
                  <Text style={styles.pageText}>
                    Next
                  </Text>
                  <ChevronRight
                    size={16}
                    color={GOLD}
                  />
                </Pressable>
              </View>
            </View>
          ) : undefined
        }
      />

      {/* ======================================================
          CREATE / EDIT SERVICE MODAL
      ====================================================== */}
      <Modal
        visible={editorVisible}
        transparent
        animationType="slide"
        onRequestClose={closeEditor}
      >
        <KeyboardAvoidingView
          style={[
            styles.overlay,
            {
              paddingTop: Math.max(12, insets.top),
              paddingBottom: Math.max(
                12,
                insets.bottom
              ),
            },
          ]}
          behavior={
            Platform.OS === "ios"
              ? "padding"
              : "height"
          }
        >
          <View style={styles.modalCard}>
            <View style={styles.modalHeader}>
              <View style={styles.flex}>
                <Text style={styles.modalEyebrow}>
                  SERVICE MANAGEMENT
                </Text>

                <Text style={styles.modalTitle}>
                  {editing
                    ? "Edit Service"
                    : "Create New Service"}
                </Text>
              </View>

              <Pressable
                disabled={saving}
                onPress={closeEditor}
                style={styles.headerButton}
              >
                <X size={19} color={C.text} />
              </Pressable>
            </View>

            <ScrollView
              keyboardShouldPersistTaps="handled"
              showsVerticalScrollIndicator={false}
              contentContainerStyle={styles.modalBody}
            >
              <View style={styles.formIntro}>
                <View style={styles.formIntroIcon}>
                  <Scissors size={23} color={GOLD} />
                </View>

                <View style={styles.flex}>
                  <Text style={styles.formIntroTitle}>
                    {editing
                      ? "Refine Your Service"
                      : "Add to Your Collection"}
                  </Text>

                  <Text style={styles.formIntroSubtitle}>
                    Keep your service details accurate
                    and attractive to customers.
                  </Text>
                </View>
              </View>

              <Notice message={formError} />

              <Text style={styles.label}>
                SERVICE NAME
              </Text>

              <TextInput
                value={form.service_name}
                onChangeText={(value) =>
                  changeForm("service_name", value)
                }
                style={styles.input}
                placeholder="e.g. Premium Haircut"
                placeholderTextColor={C.textMuted}
                editable={!saving}
                maxLength={150}
              />

              <Text style={styles.label}>
                DESCRIPTION
              </Text>

              <TextInput
                value={form.description}
                onChangeText={(value) =>
                  changeForm("description", value)
                }
                style={[
                  styles.input,
                  styles.descriptionInput,
                ]}
                placeholder="Describe your professional service..."
                placeholderTextColor={C.textMuted}
                multiline
                maxLength={2000}
                textAlignVertical="top"
                editable={!saving}
              />

              <Text style={styles.label}>
                DURATION (MINUTES)
              </Text>

              <TextInput
                value={form.duration_minutes}
                onChangeText={(value) =>
                  changeForm("duration_minutes", value)
                }
                style={styles.input}
                placeholder="30"
                placeholderTextColor={C.textMuted}
                keyboardType="number-pad"
                editable={!saving}
              />

              <Text style={styles.label}>
                SERVICE PRICE (₹)
              </Text>

              <TextInput
                value={form.price}
                onChangeText={(value) =>
                  changeForm("price", value)
                }
                style={styles.input}
                placeholder="Enter service price"
                placeholderTextColor={C.textMuted}
                keyboardType="decimal-pad"
                editable={!saving}
              />

              <View style={styles.formHint}>
                <ShieldCheck size={17} color={GOLD} />

                <Text style={styles.formHintText}>
                  Changes to your service catalogue
                  are saved using your existing
                  KSHURAK FastAPI backend.
                </Text>
              </View>

              <View style={styles.modalActions}>
                <ActionButton
                  title="Cancel"
                  disabled={saving}
                  onPress={closeEditor}
                />

                <ActionButton
                  title={
                    saving
                      ? "Saving..."
                      : editing
                      ? "Save Changes"
                      : "Create Service"
                  }
                  icon={CheckCircle2}
                  primary
                  loading={saving}
                  disabled={saving}
                  onPress={() => void saveService()}
                />
              </View>
            </ScrollView>
          </View>
        </KeyboardAvoidingView>
      </Modal>
    </SafeAreaView>
  );
}

