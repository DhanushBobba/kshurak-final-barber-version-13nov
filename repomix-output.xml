                    {replyText.length}/3000 characters
                  </Text>
                  <Notice message={replyError} />
                  <View style={styles.modalActions}>
                    <SmallButton
                      title="Cancel"
                      disabled={saving}
                      onPress={closeReply}
                    />
                    <SmallButton
                      title={saving ? "Saving..." : "Save Reply"}
                      primary
                      disabled={saving || !replyText.trim()}
