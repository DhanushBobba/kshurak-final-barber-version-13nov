            size={16}
            color={GOLD}
          />

          <View style={styles.flex}>
            <Text style={styles.metaLabel}>
              DATE
            </Text>
            <Text style={styles.metaValue}>
              {formatDate(
                booking.booking_date
              )}
            </Text>
          </View>
        </View>

        <View style={styles.metaCard}>
          <Clock3
            size={16}
            color={GOLD}
          />

          <View style={styles.flex}>
            <Text style={styles.metaLabel}>
              TIME
            </Text>
            <Text style={styles.metaValue}>
              {formatTime(
                booking.start_time
              )}
            </Text>
          </View>
        </View>
      </View>

      <View style={styles.durationRow}>
        <Text style={styles.durationLabel}>
          Service duration
        </Text>

        <Text style={styles.durationValue}>
          {formatDuration(
            booking.service_duration_minutes
          )}
        </Text>
      </View>

      {hasSavedHairstyle(booking) && (
        <View style={styles.lookBadge}>
          <Sparkles
            size={15}
            color={GOLD}
          />

          <Text
            numberOfLines={2}
            style={styles.lookBadgeText}
          >
            {booking.hairstyle_name ||
              booking.hairstyle_selection
                ?.hairstyle_name ||
              "Customer selected hairstyle"}
          </Text>

          <CheckCircle2
            size={15}
            color={SUCCESS}
          />
        </View>
      )}

      <View style={styles.bookingCardFooter}>
        <ActionButton
          title="Details"
          icon={Eye}
          disabled={disabled}
          onPress={() => onView(booking)}
        />

        {status === "pending" && (
          <>
            <ActionButton
              title="Reject"
              danger
              disabled={disabled}
              onPress={() =>
                onAction(booking, "reject")
              }
            />

            <ActionButton
              title="Accept"
              primary
              disabled={disabled}
              icon={CheckCircle2}
              onPress={() =>
                onAction(booking, "accept")
              }
            />
          </>
        )}

        {status === "confirmed" && (
          <ActionButton
            title="Complete"
            primary
            disabled={disabled}
            icon={CalendarCheck}
            onPress={() =>
              onAction(booking, "complete")
            }
          />
        )}
      </View>
    </View>
  );
}

// ============================================================
// MAIN SCREEN
// ============================================================

export default function BookingsScreen({
  onBack,
}: Props) {
  const insets = useSafeAreaInsets();
  const { width } = useWindowDimensions();

  const [bookings, setBookings] =
    useState<BarberBooking[]>([]);

  const [category, setCategory] =
    useState<Category>("total");

  const [dateFilter, setDateFilter] =
    useState<DateFilter>("all");

  const [search, setSearch] =
    useState("");

  const [loading, setLoading] =
    useState(true);

  const [refreshing, setRefreshing] =
    useState(false);

  const [saving, setSaving] =
    useState(false);

  const [hasLoaded, setHasLoaded] =
    useState(false);

  const [error, setError] =
    useState("");

  const [success, setSuccess] =
    useState("");

  const [actionError, setActionError] =
    useState("");

  const [outcomeUnknown, setOutcomeUnknown] =
    useState(false);

  const [selected, setSelected] =
    useState<BarberBooking | null>(null);

  const [action, setAction] =
    useState<BookingAction | null>(null);

  const [reason, setReason] =
    useState("");

  const mounted = useRef(false);
  const requestId = useRef(0);
  const mutation = useRef(false);
  const controller =
    useRef<AbortController | null>(null);

  const busy =
    loading || refreshing || saving;

  const mutationDisabled =
    busy || outcomeUnknown;

  const columns =
    width >= 760
      ? 4
      : width < 340
      ? 1
      : 2;

  // ----------------------------------------------------------
  // LOAD BOOKINGS
  // ----------------------------------------------------------

  const loadBookings = useCallback(
    async (
      refresh = false
    ): Promise<boolean> => {
      const current = ++requestId.current;

      controller.current?.abort();

      const abort = new AbortController();
      controller.current = abort;

      if (mounted.current) {
        setLoading(!refresh);
        setRefreshing(refresh);
        setError("");
      }

      try {
        const result =
          await getBarberBookings(
            { status: "all" },
            abort.signal
          );

        if (
          !mounted.current ||
          abort.signal.aborted ||
          current !== requestId.current
        ) {
          return false;
        }

        setBookings(result.bookings);
        setHasLoaded(true);

        return true;
      } catch (err: unknown) {
        if (
          !mounted.current ||
          abort.signal.aborted ||
          current !== requestId.current
        ) {
          return false;
        }

        setError(messageOf(err));
        return false;
      } finally {
        if (
          mounted.current &&
          current === requestId.current
        ) {
          setLoading(false);
          setRefreshing(false);
        }

        if (controller.current === abort) {
          controller.current = null;
        }
      }
    },
    []
  );

  useEffect(() => {
    mounted.current = true;

    void loadBookings();

    return () => {
      mounted.current = false;
      requestId.current += 1;
      controller.current?.abort();
    };
  }, [loadBookings]);

  // ----------------------------------------------------------
  // DATE FILTER
  // ----------------------------------------------------------

  const dateBookings = useMemo(
    () =>
      bookings.filter((booking) =>
        matchesDate(
          booking.booking_date,
          dateFilter
        )
      ),
    [bookings, dateFilter]
  );

  // ----------------------------------------------------------
  // SUMMARY STATS
  // ----------------------------------------------------------

  const counts = useMemo(
    () => ({
      total: dateBookings.length,

      upcoming: dateBookings.filter(
        (booking) =>
          booking.status === "confirmed"
      ).length,

      completed: dateBookings.filter(
        (booking) =>
          booking.status === "completed"
      ).length,

      cancelled: dateBookings.filter(
        (booking) =>
          booking.status === "cancelled" ||
          booking.status === "rejected"
      ).length,
    }),
    [dateBookings]
  );

  const pendingCount = dateBookings.filter(
    (booking) =>
      booking.status === "pending"
  ).length;

  // ----------------------------------------------------------
  // SEARCH AND CATEGORY FILTER
  // ----------------------------------------------------------

  const visibleBookings = useMemo(() => {
    const query = search.trim().toLowerCase();

    return dateBookings
      .filter((booking) =>
        matchesCategory(
          category,
          booking.status
        )
      )
      .filter((booking) => {
        if (!query) return true;

        return [
          booking.id,
          booking.customer_name,
          booking.customer_phone,
          booking.service_name,
          booking.hairstyle_name,
          booking.hairstyle_selection
            ?.hairstyle_name,
        ].some((value) =>
          String(value ?? "")
            .toLowerCase()
            .includes(query)
        );
      })
      .sort(sortNewest);
  }, [
    dateBookings,
    category,
    search,
  ]);

  // ----------------------------------------------------------
  // REFRESH
  // ----------------------------------------------------------

  const refresh = async () => {
    if (busy || mutation.current) return;

    setSuccess("");

    const refreshed =
      await loadBookings(true);

    if (
      !mounted.current ||
      !refreshed
    ) {
      return;
    }

    setOutcomeUnknown(false);
    setAction(null);
    setSelected(null);
    setReason("");
    setActionError("");
  };

  // ----------------------------------------------------------
  // OPEN ACTION
  // ----------------------------------------------------------

  const openAction = (
    booking: BarberBooking,
    type: ActionType
  ) => {
    if (
      mutation.current ||
      mutationDisabled
    ) {
      return;
    }

    setSelected(null);
    setReason("");
    setActionError("");
    setSuccess("");

    setAction({
      booking,
      type,
    });
  };

  const closeAction = () => {
    if (mutation.current) return;

    setAction(null);
    setReason("");
    setActionError("");
  };

  // ----------------------------------------------------------
  // PERFORM BOOKING ACTION
  // ----------------------------------------------------------

  const performAction = async () => {
    if (
      !action ||
      mutation.current ||
      mutationDisabled
    ) {
      return;
    }

    const currentAction = action;
    const trimmedReason = reason.trim();

    if (
      (
        currentAction.type === "reject" ||
        currentAction.type === "cancel"
      ) &&
      (
        trimmedReason.length < 3 ||
        trimmedReason.length > 500
      )
    ) {
      setActionError(
        "Enter a reason between 3 and 500 characters."
      );
      return;
    }

    mutation.current = true;

    setSaving(true);
    setActionError("");
    setError("");
    setSuccess("");

    try {
      const id = currentAction.booking.id;

      let result: BookingActionResponse;

      switch (currentAction.type) {
        case "accept":
          result = await acceptBarberBooking(id);
          break;

        case "reject":
          result = await rejectBarberBooking(
            id,
            trimmedReason
          );
          break;

        case "complete":
          result = await completeBarberBooking(
            id
          );
          break;

        case "cancel":
          result = await cancelBarberBooking(
            id,
            trimmedReason
          );
          break;
      }

      if (!mounted.current) return;

      if (
        !result.booking ||
        result.booking.id !== id
      ) {
        setOutcomeUnknown(true);

        setActionError(
          "The result could not be verified. Refresh bookings before taking another action."
        );

        return;
      }

      const updated = result.booking;

      // Avoid keeping large hairstyle previews
      // permanently in the booking list.
      const lightweight: BarberBooking = {
        ...updated,

        has_hairstyle_selection:
          updated.has_hairstyle_selection ??
          Boolean(
            updated.hairstyle_selection
          ),

        hairstyle_name:
          updated.hairstyle_name ??
          updated.hairstyle_selection
            ?.hairstyle_name ??
          null,

        hairstyle_selection: null,
        hairstyle_details_loaded: false,
      };

      setBookings((previous) =>
        previous.map((booking) =>
          booking.id === id
            ? lightweight
            : booking
        )
      );

      setAction(null);
      setSelected(null);
      setReason("");
      setActionError("");

      setSuccess(
        result.message ||
          "Booking updated successfully."
      );

      await loadBookings(true);
    } catch (err: unknown) {
      if (!mounted.current) return;

      const uncertain =
        err instanceof BookingApiError
          ? err.outcomeUnknown
          : true;

      if (uncertain) {
        setOutcomeUnknown(true);
      }

      setActionError(messageOf(err));
    } finally {
      mutation.current = false;

      if (mounted.current) {
        setSaving(false);
      }
    }
  };

  // ==========================================================
  // RENDER
  // ==========================================================

  return (
    <SafeAreaView
      edges={["top", "left", "right"]}
      style={styles.screen}
    >
      {/* HEADER */}

      <View style={styles.header}>
        <Pressable
          onPress={onBack}
          style={styles.headerButton}
          accessibilityLabel="Back to dashboard"
        >
          <ArrowLeft
            size={20}
            color={C.text}
          />
        </Pressable>

        <View style={styles.flex}>
          <Text style={styles.headerEyebrow}>
            KSHURAK BARBER
          </Text>

          <Text style={styles.headerTitle}>
            Bookings
          </Text>
        </View>

        <Pressable
          disabled={busy}
          onPress={() => void refresh()}
          style={styles.headerButton}
          accessibilityLabel="Refresh bookings"
        >
          {refreshing ? (
            <ActivityIndicator
              color={GOLD}
              size="small"
            />
          ) : (
            <RefreshCw
              size={19}
              color={GOLD}
            />
          )}
        </Pressable>
      </View>

      {/* CONTENT */}

      <ScrollView
        keyboardShouldPersistTaps="handled"
        showsVerticalScrollIndicator={false}
        contentContainerStyle={[
          styles.content,
          {
            paddingBottom: Math.max(
              30,
              insets.bottom + 24
            ),
          },
        ]}
      >
        {/* HERO */}

        <View style={styles.hero}>
          <View style={styles.heroIcon}>
            <CalendarCheck
              size={25}
              color={GOLD}
            />
          </View>

          <View style={styles.heroTopRow}>
            <View style={styles.heroBadge}>
              <View style={styles.heroBadgeDot} />

              <Text style={styles.heroBadgeText}>
                BOOKING MANAGEMENT
              </Text>
            </View>
          </View>

          <Text style={styles.heroTitle}>
            Every Appointment.
            {"\n"}
            <Text style={styles.heroGold}>
              Perfectly Managed.
            </Text>
          </Text>

          <Text style={styles.heroDescription}>
            Manage customer bookings, confirm
            appointments and keep your shop
            running smoothly.
          </Text>

          <View style={styles.heroFooter}>
            <View style={styles.heroMetric}>
              <Text style={styles.heroMetricValue}>
                {counts.total}
              </Text>

              <Text style={styles.heroMetricLabel}>
                BOOKINGS
              </Text>
            </View>

            <View style={styles.heroMetricDivider} />

            <View style={styles.heroMetric}>
              <Text style={styles.heroMetricValue}>
                {pendingCount}
              </Text>

              <Text style={styles.heroMetricLabel}>
                PENDING
              </Text>
            </View>

            <View style={styles.heroMetricDivider} />

            <View style={styles.heroMetric}>
              <Text style={styles.heroMetricValue}>
                {counts.completed}
              </Text>

              <Text style={styles.heroMetricLabel}>
                COMPLETED
              </Text>
            </View>
          </View>
        </View>

        <Message text={error} />
        <Message text={success} success />

        {outcomeUnknown && (
          <View style={styles.warningBox}>
            <ShieldCheck
              size={18}
              color={GOLD}
            />

            <View style={styles.flex}>
              <Text style={styles.warningTitle}>
                Booking status needs verification
              </Text>

              <Text style={styles.warningText}>
                A previous update may have succeeded.
                Refresh the booking list before
                submitting another action.
              </Text>
            </View>
          </View>
        )}

        {/* SUMMARY CARDS */}

        <View style={styles.sectionHeader}>
          <View>
            <Text style={styles.sectionEyebrow}>
              BUSINESS OVERVIEW
            </Text>

            <Text style={styles.sectionTitle}>
              Booking Insights
            </Text>
          </View>

          <View style={styles.sectionIcon}>
            <Sparkles
              size={17}
              color={GOLD}
            />
          </View>
        </View>

        <View style={styles.summaryGrid}>
          {SUMMARY_CARDS.map((card) => (
            <View
              key={card.key}
              style={{
                width:
                  columns === 4
                    ? "23.5%"
                    : columns === 1
                    ? "100%"
                    : "48.4%",
              }}
            >
              <PremiumSummaryCard
                card={card}
                count={counts[card.key]}
                active={category === card.key}
                onPress={() =>
                  setCategory(card.key)
                }
              />
            </View>
          ))}
        </View>

        {/* SEARCH AND FILTERS */}

        <View style={styles.sectionHeader}>
          <View>
            <Text style={styles.sectionEyebrow}>
              APPOINTMENTS
            </Text>

            <Text style={styles.sectionTitle}>
              Booking Records
            </Text>
          </View>

          <View style={styles.resultBadge}>
            <Text style={styles.resultText}>
              {visibleBookings.length}
            </Text>
          </View>
        </View>

        <View style={styles.searchBox}>
          <Search
            size={18}
            color={MUTED}
          />

          <TextInput
            value={search}
            onChangeText={setSearch}
            style={styles.searchInput}
            placeholder="Search name, phone, service..."
            placeholderTextColor={C.textMuted}
            autoCorrect={false}
          />

          {!!search && (
            <Pressable
              onPress={() => setSearch("")}
            >
              <X
                size={17}
                color={MUTED}
              />
            </Pressable>
          )}
        </View>

        <ScrollView
          horizontal
          showsHorizontalScrollIndicator={false}
          contentContainerStyle={styles.filterRow}
        >
          {DATE_FILTERS.map((filter) => {
            const active =
              dateFilter === filter.key;

            return (
              <Pressable
                key={filter.key}
                onPress={() =>
                  setDateFilter(filter.key)
                }
                style={[
                  styles.filterChip,
                  active && styles.filterChipActive,
                ]}
              >
                <Text
                  style={[
                    styles.filterChipText,
                    active &&
                      styles.filterChipTextActive,
                  ]}
                >
                  {filter.label}
                </Text>
              </Pressable>
            );
          })}
        </ScrollView>

        <View style={styles.listHeading}>
          <Text style={styles.listTitle}>
            {
              SUMMARY_CARDS.find(
                (item) => item.key === category
              )?.title
            }
          </Text>

          <Text style={styles.listSubtitle}>
            Newest appointments first
          </Text>
        </View>

        {/* BOOKING LIST */}

        {loading && !hasLoaded ? (
          <View style={styles.emptyCard}>
            <ActivityIndicator
              size="large"
              color={GOLD}
            />

            <Text style={styles.emptyTitle}>
              Loading Bookings
            </Text>

            <Text style={styles.emptyDescription}>
              Retrieving your latest shop appointments...
            </Text>
          </View>
        ) : visibleBookings.length === 0 ? (
          <View style={styles.emptyCard}>
            <View style={styles.emptyIcon}>
              <CalendarDays
                size={29}
                color={GOLD}
              />
            </View>

            <Text style={styles.emptyTitle}>
              {error
                ? "Unable to Load Bookings"
                : "No Bookings Found"}
            </Text>

            <Text style={styles.emptyDescription}>
              {error
                ? "Check your connection and try again."
                : "There are no bookings matching the selected filters."}
            </Text>

            <ActionButton
              title="Refresh"
              icon={RefreshCw}
              onPress={() => void refresh()}
            />
          </View>
        ) : (
          <View style={styles.bookingList}>
            {visibleBookings.map((booking) => (
              <BookingCard
                key={booking.id}
                booking={booking}
                disabled={mutationDisabled}
                onView={setSelected}
                onAction={openAction}
              />
            ))}
          </View>
        )}

        <Text style={styles.footerNote}>
          Showing {visibleBookings.length} of{" "}
          {dateBookings.length} appointments
          for the selected date range.
        </Text>
      </ScrollView>

      {/* ======================================================
          BOOKING DETAILS MODAL
      ====================================================== */}

      <Modal
        visible={selected !== null}
        transparent
        animationType="slide"
        onRequestClose={() =>
          setSelected(null)
        }
      >
        <KeyboardAvoidingView
          style={[
            styles.overlay,
            {
              paddingTop: Math.max(
                14,
                insets.top
              ),
              paddingBottom: Math.max(
                14,
                insets.bottom
              ),
            },
          ]}
          behavior={
            Platform.OS === "ios"
              ? "padding"
              : "height"
          }
        >
          <View style={styles.modalCard}>
            <View style={styles.modalHeader}>
              <View style={styles.flex}>
                <Text style={styles.modalEyebrow}>
                  BOOKING DETAILS
                </Text>

                <Text style={styles.modalTitle}>
                  Appointment Overview
                </Text>
              </View>

              <Pressable
                onPress={() =>
                  setSelected(null)
                }
                style={styles.headerButton}
              >
                <X
                  size={20}
                  color={C.text}
                />
              </Pressable>
            </View>

            <ScrollView
              showsVerticalScrollIndicator={false}
              contentContainerStyle={styles.modalBody}
            >
              {selected && (
                <>
                  <View style={styles.detailsHero}>
                    <View style={styles.avatarLarge}>
                      <Text style={styles.avatarTextLarge}>
                        {initials(
                          selected.customer_name
                        )}
                      </Text>
                    </View>

                    <Text style={styles.detailsCustomer}>
                      {selected.customer_name}
                    </Text>

                    <StatusBadge
                      status={selected.status}
                    />
                  </View>

                  <View style={styles.detailsSection}>
                    <Text style={styles.miniHeading}>
                      APPOINTMENT INFORMATION
                    </Text>

                    <DetailRow
                      label="Booking Reference"
                      value={selected.id}
                    />

                    <DetailRow
                      label="Customer Phone"
                      value={
                        selected.customer_phone
                      }
                    />

                    <DetailRow
                      label="Service"
                      value={
                        selected.service_name
                      }
                    />

                    <DetailRow
                      label="Booking Date"
                      value={formatDate(
                        selected.booking_date
                      )}
                    />

                    <DetailRow
                      label="Start Time"
                      value={formatTime(
                        selected.start_time
                      )}
                    />

                    <DetailRow
                      label="End Time"
                      value={formatTime(
                        selected.end_time
                      )}
                    />

                    <DetailRow
                      label="Duration"
                      value={formatDuration(
                        selected.service_duration_minutes
                      )}
                    />

                    <DetailRow
                      label="Service Price"
                      value={formatPrice(
                        selected.service_price
                      )}
                    />

                    <DetailRow
                      label="Worker ID"
                      value={
                        selected.worker_id
                      }
                    />
                  </View>

                  <BookingHairstylePanel
                    key={`hairstyle-${selected.id}`}
                    booking={selected}
                  />

                  {!!selected.customer_notes && (
                    <DetailRow
                      label="Customer Notes"
                      value={
                        selected.customer_notes
                      }
                    />
                  )}

                  {!!selected.cancellation_reason && (
                    <DetailRow
                      label="Cancellation Reason"
                      value={
                        selected.cancellation_reason
                      }
                    />
                  )}

                  <View style={styles.modalActions}>
                    {selected.status ===
                      "pending" && (
                      <>
                        <ActionButton
                          title="Reject"
                          danger
                          disabled={mutationDisabled}
                          onPress={() =>
                            openAction(
                              selected,
                              "reject"
                            )
                          }
                        />

                        <ActionButton
                          title="Accept"
                          primary
                          disabled={mutationDisabled}
                          onPress={() =>
                            openAction(
                              selected,
                              "accept"
                            )
                          }
                        />
                      </>
                    )}

                    {selected.status ===
                      "confirmed" && (
                      <>
                        <ActionButton
                          title="Cancel"
                          danger
                          disabled={mutationDisabled}
                          onPress={() =>
                            openAction(
                              selected,
                              "cancel"
                            )
                          }
                        />

                        <ActionButton
                          title="Complete"
                          primary
                          disabled={mutationDisabled}
                          onPress={() =>
                            openAction(
                              selected,
                              "complete"
                            )
                          }
                        />
                      </>
                    )}
                  </View>
                </>
              )}
            </ScrollView>
          </View>
        </KeyboardAvoidingView>
      </Modal>

      {/* ======================================================
          ACTION CONFIRMATION MODAL
      ====================================================== */}

      <Modal
        visible={action !== null}
        transparent
        animationType="fade"
        onRequestClose={closeAction}
      >
        <KeyboardAvoidingView
          style={styles.overlay}
          behavior={
            Platform.OS === "ios"
              ? "padding"
              : "height"
          }
        >
          <View style={styles.confirmCard}>
            <View style={styles.modalHeader}>
              <View style={styles.flex}>
                <Text style={styles.modalEyebrow}>
                  CONFIRM ACTION
                </Text>

                <Text style={styles.modalTitle}>
                  {action
                    ? actionTitle(action.type)
                    : "Booking Action"}
                </Text>
              </View>

              <Pressable
                disabled={saving}
                onPress={closeAction}
                style={styles.headerButton}
              >
                <X
                  size={19}
                  color={C.text}
                />
              </Pressable>
            </View>

            <ScrollView
              keyboardShouldPersistTaps="handled"
              contentContainerStyle={styles.modalBody}
              showsVerticalScrollIndicator={false}
            >
              {action && (
                <>
                  <View style={styles.confirmInfo}>
                    <Text style={styles.confirmName}>
                      {action.booking.customer_name}
                    </Text>

                    <Text style={styles.secondary}>
                      {action.booking.service_name}
                    </Text>

                    <Text style={styles.goldText}>
                      {formatDate(
                        action.booking.booking_date
                      )}
                      {" · "}
                      {formatTime(
                        action.booking.start_time
                      )}
                    </Text>
                  </View>

                  <Text style={styles.confirmQuestion}>
                    Are you sure you want to{" "}
                    {action.type} this booking?
                  </Text>

                  {action.type === "accept" && (
                    <View style={styles.confirmNotice}>
                      <ShieldCheck
                        size={17}
                        color={GOLD}
                      />

                      <Text style={styles.confirmNoticeText}>
                        Confirming the booking
                        will update its appointment status.
                      </Text>
                    </View>
                  )}

                  {(action.type === "reject" ||
                    action.type === "cancel") && (
                    <>
                      <Text style={styles.miniHeading}>
                        REASON
                      </Text>

                      <TextInput
                        value={reason}
                        onChangeText={setReason}
                        editable={!saving}
                        multiline
                        maxLength={500}
                        textAlignVertical="top"
                        style={styles.reasonInput}
                        placeholder="Explain the reason..."
                        placeholderTextColor={C.textMuted}
                      />
                    </>
                  )}

                  <Message text={actionError} />

                  {outcomeUnknown && (
                    <Text style={styles.warningText}>
                      Refresh booking status
                      before submitting again.
                    </Text>
                  )}

                  <View style={styles.modalActions}>
                    <ActionButton
                      title="Back"
                      disabled={saving}
                      onPress={closeAction}
                    />

                    <ActionButton
                      title={
                        saving
                          ? "Processing..."
                          : actionTitle(action.type)
                      }
                      primary={
                        action.type === "accept" ||
                        action.type === "complete"
                      }
                      danger={
                        action.type === "reject" ||
                        action.type === "cancel"
                      }
                      disabled={
                        saving ||
                        outcomeUnknown
                      }
                      loading={saving}
                      onPress={() =>
                        void performAction()
                      }
                    />
                  </View>
                </>
              )}
            </ScrollView>
          </View>
        </KeyboardAvoidingView>
      </Modal>
    </SafeAreaView>
  );
}

