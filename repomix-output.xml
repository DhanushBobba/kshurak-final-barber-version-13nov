}

// ============================================================
// MAIN SCREEN
// ============================================================

export default function WorkersScreen({ onBack }: Props) {
  const focused = useIsFocused();
  const insets = useSafeAreaInsets();

  const mounted = useRef(true);
  const mutation = useRef(false);

  const [tab, setTab] = useState<Tab>("workers");

  const [workers, setWorkers] =
    useState<ShopSetupWorker[]>([]);

  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);

  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");

  const [search, setSearch] = useState("");
  const [filter, setFilter] =
    useState<WorkerFilter>("all");

  const [editor, setEditor] =
    useState<WorkerEditor | null>(null);

  const [editorError, setEditorError] =
    useState("");

  // SLOT STATE
  const [workerId, setWorkerId] = useState("");
  const [slotDate, setSlotDate] = useState(todayISO());

  const [slotData, setSlotData] =
    useState<WorkerSlotResponse | null>(null);

  const [slots, setSlots] =
    useState<Record<string, boolean>>({});

  const [breaks, setBreaks] =
    useState<WorkerBreak[]>([]);

  const [week, setWeek] =
    useState<WeeklyDays>({ ...DEFAULT_WEEK });

  const [slotLoading, setSlotLoading] = useState(false);
  const [slotSaving, setSlotSaving] = useState(false);
  const [slotError, setSlotError] = useState("");
  const [slotRevision, setSlotRevision] = useState(0);
  const [weekRevision, setWeekRevision] = useState(0);

  const [weekLoading, setWeekLoading] = useState(false);
  const [weekSaving, setWeekSaving] = useState(false);
  const [weekError, setWeekError] = useState("");

  const [breakStart, setBreakStart] = useState("13:00");
  const [breakEnd, setBreakEnd] = useState("14:00");

  // PERFORMANCE STATE
  const [period, setPeriod] = useState<Period>("7days");

  const [performanceBookings, setPerformanceBookings] =
    useState<BarberBooking[]>([]);

  const [performanceLoading, setPerformanceLoading] =
    useState(false);

  const [performanceError, setPerformanceError] =
    useState("");

  const [performanceRevision, setPerformanceRevision] =
    useState(0);

  // ==========================================================
  // LOAD WORKERS
  // ==========================================================

  const loadWorkers = useCallback(async () => {
    setLoading(true);
    setError("");

    try {
      const data = await getShopSetupWorkers();

      if (!mounted.current) return;

      setWorkers(data);

      setWorkerId((current) =>
        data.some((item) => item.id === current)
          ? current
          : data[0]?.id || ""
      );
    } catch (err) {
      if (mounted.current) setError(message(err));
    } finally {
      if (mounted.current) setLoading(false);
    }
  }, []);

  useEffect(() => {
    mounted.current = true;
    return () => {
      mounted.current = false;
    };
  }, []);

  useEffect(() => {
    if (!focused) return;
    void loadWorkers();
  }, [focused, loadWorkers]);

  // ==========================================================
  // LOAD WEEKLY SCHEDULE
  // ==========================================================

  useEffect(() => {
    if (!focused || tab !== "slots" || !workerId) return;

    let active = true;
    const abort = new AbortController();

    setWeekLoading(true);
    setWeekError("");

    void getShopSetupWorkerWeeklySchedule(
      workerId,
      abort.signal
    )
      .then((result) => {
        if (active) setWeek(result.weekly_days);
      })
      .catch((err) => {
        if (active && !abort.signal.aborted) {
          setWeekError(message(err));
        }
      })
      .finally(() => {
        if (active) setWeekLoading(false);
      });

    return () => {
      active = false;
      abort.abort();
    };
  }, [focused, tab, workerId, weekRevision]);

  // ==========================================================
  // LOAD WORKER SLOTS
  // ==========================================================

  useEffect(() => {
    if (!focused || tab !== "slots" || !workerId) return;

    let active = true;
    const abort = new AbortController();

    setSlotLoading(true);
    setSlotError("");
    setSlotData(null);
    setSlots({});
    setBreaks([]);

    void getShopSetupWorkerSlots(
      workerId,
      slotDate,
      abort.signal
    )
      .then((result) => {
        if (!active) return;

        setSlotData(result);
        setSlots(result.slots);
        setBreaks(result.breaks);
      })
      .catch((err) => {
        if (active && !abort.signal.aborted) {
          setSlotError(message(err));
        }
      })
      .finally(() => {
        if (active) setSlotLoading(false);
      });

    return () => {
      active = false;
      abort.abort();
    };
  }, [
    focused,
    tab,
    workerId,
    slotDate,
    slotRevision,
  ]);

  // ==========================================================
  // PERFORMANCE DATA
  // ==========================================================

  const range = useMemo(
    () => rangeForPeriod(period),
    [period]
  );

  useEffect(() => {
    if (!focused || tab !== "performance") return;

    let active = true;
    const abort = new AbortController();

    setPerformanceLoading(true);
    setPerformanceError("");

    void getBarberBookings(
      {
        dateFrom: range.from,
        dateTo: range.to,
      },
      abort.signal
    )
      .then((result) => {
        if (active) {
          setPerformanceBookings(result.bookings);
        }
      })
      .catch((err) => {
        if (active && !abort.signal.aborted) {
          setPerformanceError(message(err));
        }
      })
      .finally(() => {
        if (active) setPerformanceLoading(false);
      });

    return () => {
      active = false;
      abort.abort();
    };
  }, [
    focused,
    tab,
    range.from,
    range.to,
    performanceRevision,
  ]);

  // ==========================================================
  // WORKER STATISTICS
  // ==========================================================

  const activeWorkers = workers.filter(
    (worker) => worker.is_active
  ).length;

  const filteredWorkers = useMemo(() => {
    const query = search.trim().toLowerCase();

    return workers.filter((worker) => {
      if (filter === "active" && !worker.is_active) {
        return false;
      }

      if (filter === "inactive" && worker.is_active) {
        return false;
      }

      return (
        !query ||
        [
          worker.full_name,
          worker.phone,
          worker.role,
          worker.specializations,
        ].some((value) =>
          String(value || "")
            .toLowerCase()
            .includes(query)
        )
      );
    });
  }, [workers, filter, search]);

  const stats = useMemo<WorkerPerformance[]>(() => {
    return workers.map((worker) => {
      const own = performanceBookings.filter(
        (booking) => booking.worker_id === worker.id
      );

      const completed = own.filter(
        (booking) => booking.status === "completed"
      );

      const cancelled = own.filter(
        (booking) => booking.status === "cancelled"
      ).length;

      const resolved = completed.length + cancelled;

      return {
        worker,
        total: own.length,
        completed: completed.length,
        cancelled,
        confirmed: own.filter(
          (booking) => booking.status === "confirmed"
        ).length,
        pending: own.filter(
          (booking) => booking.status === "pending"
        ).length,
        minutes: completed.reduce(
          (sum, booking) =>
            sum +
            (Number(booking.service_duration_minutes) || 0),
          0
        ),
        rate: resolved
          ? (completed.length / resolved) * 100
          : null,
      };
    });
  }, [workers, performanceBookings]);

  const performanceTotals = useMemo(
    () => ({
      bookings: stats.reduce((sum, item) => sum + item.total, 0),
      completed: stats.reduce(
        (sum, item) => sum + item.completed,
        0
      ),
      minutes: stats.reduce(
        (sum, item) => sum + item.minutes,
        0
      ),
    }),
    [stats]
  );

  // ==========================================================
  // WORKER ACTIONS
  // ==========================================================

  const openEditor = (worker?: ShopSetupWorker) => {
    setEditorError("");

    setEditor(
      worker
        ? { ...fromShopSetupWorker(worker), id: worker.id }
        : { ...EMPTY_WORKER }
    );
  };

  const changeEditor = (
    key: keyof WorkerFormValues,
    value: string | boolean
  ) => {
    setEditor((current) =>
      current
        ? { ...current, [key]: value }
        : null
    );
  };

  const saveWorker = async () => {
    if (!editor || mutation.current) return;

    const issue = validateWorker(editor);

    if (issue) {
      setEditorError(issue);
      return;
    }

    mutation.current = true;
    setSaving(true);
    setEditorError("");

    try {
      const payload = toShopSetupWorkerPayload(editor);

      if (editor.id) {
        await updateShopSetupWorker(editor.id, payload);
      } else {
        await createShopSetupWorker(payload);
      }

      if (!mounted.current) return;

      setEditor(null);
      setSuccess("Worker saved successfully.");
      await loadWorkers();
    } catch (err) {
      if (mounted.current) setEditorError(message(err));
    } finally {
      mutation.current = false;
      if (mounted.current) setSaving(false);
    }
  };

  const toggleWorker = (worker: ShopSetupWorker) => {
    if (mutation.current) return;

    Alert.alert(
      worker.is_active
        ? "Deactivate Worker?"
        : "Activate Worker?",
      `${worker.full_name} will be ${
        worker.is_active ? "deactivated" : "activated"
      }.`,
      [
        { text: "Cancel", style: "cancel" },
        {
          text: "Confirm",
          onPress: () => {
            void (async () => {
              if (mutation.current) return;

              mutation.current = true;
              setSaving(true);

              try {
                await setShopSetupWorkerActive(
                  worker.id,
                  !worker.is_active
                );

                setSuccess("Worker status updated.");
                await loadWorkers();
              } catch (err) {
                setError(message(err));
              } finally {
                mutation.current = false;
                if (mounted.current) setSaving(false);
              }
            })();
          },
        },
      ]
    );
  };

  // ==========================================================
  // SLOT ACTIONS
  // ==========================================================

  const selectedWorker = workers.find(
    (worker) => worker.id === workerId
  );

  const slotEntries = useMemo(() => {
    if (!slotData) return [];

    const start = minutes(slotData.shift_start);
    const end = minutes(slotData.shift_end);
    const result: string[] = [];

    if (
      !Number.isFinite(start) ||
      !Number.isFinite(end)
    ) {
      return result;
    }

    for (
      let time = start;
      time + SLOT_DURATION <= end;
      time += SLOT_DURATION
    ) {
      if (time + SLOT_DURATION > 1440) break;
      result.push(timeString(time));
    }

    return result;
  }, [slotData]);

  const availableSlots = slotEntries.filter(
    (time) =>
      slots[time] !== false &&
      !overlap(
        minutes(time),
        minutes(time) + SLOT_DURATION,
        breaks
      )
  ).length;

  const addBreak = () => {
    const start = minutes(breakStart);
    const end = minutes(breakEnd);

    if (
      !Number.isFinite(start) ||
      !Number.isFinite(end) ||
      end <= start
    ) {
      setSlotError("Enter valid break times.");
      return;
    }

    if (
      !slotData ||
      start < minutes(slotData.shift_start) ||
      end > minutes(slotData.shift_end)
    ) {
      setSlotError("Break must be inside the worker shift.");
      return;
    }

    if (overlap(start, end, breaks)) {
      setSlotError("Break overlaps an existing break.");
      return;
    }

    setSlotError("");

    setBreaks((current) => [
      ...current,
      {
        id: `break-${Date.now()}`,
        start: breakStart,
        end: breakEnd,
      },
    ]);
  };

  const saveSlots = async () => {
    if (!workerId || !slotData || mutation.current) return;

    if (slotData.slot_duration_minutes !== SLOT_DURATION) {
      setSlotError(
        "The backend is not configured for 60-minute slots."
      );
      return;
    }

    mutation.current = true;
    setSlotSaving(true);
    setSlotError("");

    try {
      const response = await saveShopSetupWorkerSlots(
        workerId,
        slotDate,
        { slots, breaks }
      );

      if (!mounted.current) return;

      setSlotData(response);
      setSlots(response.slots);
      setBreaks(response.breaks);
      setSuccess("Worker slots saved successfully.");
    } catch (err) {
      if (mounted.current) setSlotError(message(err));
    } finally {
      mutation.current = false;
      if (mounted.current) setSlotSaving(false);
    }
  };

  const saveWeek = async () => {
    if (!workerId || mutation.current) return;

    mutation.current = true;
    setWeekSaving(true);
    setWeekError("");

    try {
      const response =
        await saveShopSetupWorkerWeeklySchedule(
          workerId,
          week
        );

      if (!mounted.current) return;

      setWeek(response.weekly_days);
      setSuccess("Weekly schedule saved successfully.");
    } catch (err) {
      if (mounted.current) setWeekError(message(err));
    } finally {
      mutation.current = false;
      if (mounted.current) setWeekSaving(false);
    }
  };

  // ==========================================================
  // REFRESH
  // ==========================================================

  const refresh = () => {
    setError("");
    setSuccess("");

    if (tab === "workers") {
      void loadWorkers();
    } else if (tab === "slots") {
      setSlotRevision((value) => value + 1);
      setWeekRevision((value) => value + 1);
    } else {
      setPerformanceRevision((value) => value + 1);
    }
  };

  // ==========================================================
  // UI
  // ==========================================================

  return (
    <SafeAreaView
      edges={["top", "left", "right"]}
      style={styles.screen}
    >
      <View style={styles.header}>
        <Pressable onPress={onBack} style={styles.iconButton}>
          <ArrowLeft size={20} color={C.text} />
        </Pressable>

        <View style={styles.flex}>
          <Text style={styles.eyebrow}>
            KSHURAK BARBER
          </Text>
          <Text style={styles.headerTitle}>
            Team Management
          </Text>
        </View>

        <Pressable
          onPress={refresh}
          disabled={saving || slotSaving || weekSaving}
          style={styles.iconButton}
        >
          <RefreshCw size={19} color={GOLD} />
        </Pressable>
      </View>

      <ScrollView
        keyboardShouldPersistTaps="handled"
        showsVerticalScrollIndicator={false}
        contentContainerStyle={[
          styles.content,
          { paddingBottom: insets.bottom + 32 },
        ]}
      >
        <View style={styles.hero}>
          <View style={styles.heroTop}>
            <View style={styles.heroIcon}>
              <Users size={25} color={GOLD} />
            </View>

            <View style={styles.heroBadge}>
              <Sparkles size={14} color={GOLD} />
              <Text style={styles.heroBadgeText}>
                TEAM OPERATIONS
              </Text>
            </View>
          </View>

          <Text style={styles.heroTitle}>
            Your Team.{"\n"}
            <Text style={{ color: GOLD }}>
              Your Excellence.
            </Text>
          </Text>

          <Text style={styles.heroDescription}>
            Manage professionals, plan one-hour
            appointment slots and track team performance.
          </Text>

          <View style={styles.heroMetrics}>
            <View style={styles.heroMetric}>
              <Text style={styles.heroNumber}>
                {workers.length}
              </Text>
              <Text style={styles.heroCaption}>
                TOTAL WORKERS
              </Text>
            </View>

            <View style={styles.heroDivider} />

            <View style={styles.heroMetric}>
              <Text style={styles.heroNumber}>
                {activeWorkers}
              </Text>
              <Text style={styles.heroCaption}>
                ACTIVE
              </Text>
            </View>

            <View style={styles.heroDivider} />

            <View style={styles.heroMetric}>
              <Text style={styles.heroNumber}>
                {workers.length - activeWorkers}
              </Text>
              <Text style={styles.heroCaption}>
                INACTIVE
              </Text>
            </View>
          </View>
        </View>

        <Notice text={error} />
        <Notice text={success} success />

        {/* MAIN TABS */}
        <View style={styles.tabs}>
          {(
            [
              ["workers", "Workers"],
              ["slots", "Slots"],
              ["performance", "Performance"],
            ] as const
          ).map(([key, label]) => (
            <Pressable
              key={key}
              onPress={() => setTab(key)}
              style={[
                styles.tab,
                tab === key && styles.tabActive,
              ]}
            >
              <Text
                style={[
                  styles.tabText,
                  tab === key && styles.tabTextActive,
                ]}
              >
                {label}
              </Text>
            </Pressable>
          ))}
        </View>

        {/* ================================================
            WORKERS TAB
        ================================================ */}
        {tab === "workers" && (
          <>
            <View style={styles.sectionHeading}>
              <View>
                <Text style={styles.sectionEyebrow}>
                  TEAM DIRECTORY
                </Text>
                <Text style={styles.sectionTitle}>
                  Professionals
                </Text>
              </View>

              <Pressable
                disabled={saving}
                onPress={() => openEditor()}
                style={styles.addButton}
              >
                <Plus size={16} color={BG} />
                <Text style={styles.addButtonText}>
                  Add Worker
                </Text>
              </Pressable>
            </View>

            <View style={styles.search}>
              <Search size={17} color={MUTED} />
              <TextInput
                value={search}
                onChangeText={setSearch}
                style={styles.searchInput}
                placeholder="Search name, role or phone..."
                placeholderTextColor={C.textMuted}
              />
              {!!search && (
                <Pressable onPress={() => setSearch("")}>
                  <X size={16} color={MUTED} />
                </Pressable>
              )}
            </View>

            <View style={styles.pills}>
              {(
                ["all", "active", "inactive"] as const
              ).map((key) => (
                <Pill
                  key={key}
                  label={
                    key.charAt(0).toUpperCase() +
                    key.slice(1)
                  }
                  active={filter === key}
                  onPress={() => setFilter(key)}
                />
              ))}
            </View>

            {loading ? (
              <View style={styles.empty}>
                <ActivityIndicator color={GOLD} />
                <Text style={styles.muted}>
                  Loading professionals...
                </Text>
              </View>
            ) : filteredWorkers.length === 0 ? (
              <View style={styles.empty}>
                <Users size={30} color={GOLD} />
                <Text style={styles.emptyTitle}>
                  No Workers Found
                </Text>
                <Text style={styles.muted}>
                  Add a worker or adjust your filters.
                </Text>
              </View>
            ) : (
              <View style={styles.cardList}>
                {filteredWorkers.map((worker) => (
                  <View
                    key={worker.id}
                    style={styles.workerCard}
                  >
                    <View style={styles.workerTop}>
                      <View style={styles.avatar}>
                        <Text style={styles.avatarText}>
                          {initials(worker.full_name)}
                        </Text>
                      </View>

                      <View style={styles.flex}>
                        <Text style={styles.workerName}>
                          {worker.full_name}
                        </Text>
                        <Text style={styles.workerRole}>
                          {worker.role}
                        </Text>
                      </View>

                      <View
                        style={[
                          styles.statusBadge,
                          worker.is_active
                            ? styles.activeBadge
                            : styles.inactiveBadge,
                        ]}
                      >
                        <Text
                          style={[
                            styles.statusText,
                            {
                              color: worker.is_active
                                ? SUCCESS
                                : MUTED,
                            },
                          ]}
                        >
                          {worker.is_active
                            ? "ACTIVE"
                            : "INACTIVE"}
                        </Text>
                      </View>
                    </View>

                    <View style={styles.workerInfoGrid}>
                      <View style={styles.infoTile}>
                        <Text style={styles.infoLabel}>
                          EXPERIENCE
                        </Text>
                        <Text style={styles.infoValue}>
                          {worker.years_experience} years
                        </Text>
                      </View>

                      <View style={styles.infoTile}>
                        <Text style={styles.infoLabel}>
                          CONTACT
                        </Text>
                        <Text style={styles.infoValue}>
                          {worker.phone}
                        </Text>
                      </View>

                      <View style={styles.infoTileWide}>
                        <Clock3 size={16} color={GOLD} />
                        <View style={styles.flex}>
                          <Text style={styles.infoLabel}>
                            WORKING SHIFT
                          </Text>
                          <Text style={styles.infoValue}>
                            {formatTime(worker.shift_start)}
                            {" – "}
                            {formatTime(worker.shift_end)}
                          </Text>
                        </View>
                      </View>
                    </View>

                    {!!worker.specializations && (
                      <Text style={styles.specializations}>
                        {worker.specializations}
                      </Text>
                    )}

                    <View style={styles.cardActions}>
                      <Button
                        title="Edit Profile"
                        disabled={saving}
                        onPress={() => openEditor(worker)}
                      />
                      <Button
                        title={
                          worker.is_active
                            ? "Deactivate"
                            : "Activate"
                        }
                        primary={!worker.is_active}
                        danger={worker.is_active}
                        disabled={saving}
                        onPress={() => toggleWorker(worker)}
                      />
                    </View>
                  </View>
                ))}
              </View>
            )}
          </>
        )}

        {/* ================================================
            SLOTS TAB
        ================================================ */}
        {tab === "slots" && (
          <>
            <View style={styles.sectionHeading}>
              <View>
                <Text style={styles.sectionEyebrow}>
                  SCHEDULE CONTROL
                </Text>
                <Text style={styles.sectionTitle}>
                  Slot Management
                </Text>
              </View>
            </View>

            <Text style={styles.fieldLabel}>
              SELECT PROFESSIONAL
            </Text>

            <ScrollView
              horizontal
              showsHorizontalScrollIndicator={false}
              contentContainerStyle={styles.horizontalPills}
            >
              {workers.map((worker) => (
                <Pill
                  key={worker.id}
                  label={worker.full_name}
                  active={workerId === worker.id}
                  onPress={() => {
                    setWorkerId(worker.id);
                    setSlotError("");
                  }}
                />
              ))}
            </ScrollView>

            {!selectedWorker ? (
              <View style={styles.empty}>
                <UserRound size={30} color={GOLD} />
                <Text style={styles.emptyTitle}>
                  Select a Professional
                </Text>
                <Text style={styles.muted}>
                  Add a worker before managing slots.
                </Text>
              </View>
            ) : (
              <>
                <View style={styles.selectedWorker}>
                  <View style={styles.avatar}>
                    <Text style={styles.avatarText}>
                      {initials(selectedWorker.full_name)}
                    </Text>
                  </View>
                  <View style={styles.flex}>
                    <Text style={styles.workerName}>
                      {selectedWorker.full_name}
                    </Text>
                    <Text style={styles.muted}>
                      {selectedWorker.role} ·{" "}
                      {formatTime(selectedWorker.shift_start)}
                      {" – "}
                      {formatTime(selectedWorker.shift_end)}
                    </Text>
                  </View>
                </View>

                <View style={styles.sectionHeading}>
                  <View>
                    <Text style={styles.sectionEyebrow}>
                      WEEKLY AVAILABILITY
                    </Text>
                    <Text style={styles.sectionTitle}>
                      Working Days
                    </Text>
                  </View>
                </View>

                <Notice text={weekError} />

                {weekLoading ? (
                  <ActivityIndicator color={GOLD} />
                ) : (
                  <View style={styles.weekPanel}>
                    {WEEK_DAYS.map((day) => (
                      <View
                        key={day}
                        style={styles.weekRow}
                      >
                        <View style={styles.flex}>
                          <Text style={styles.weekDay}>
                            {day}
                          </Text>
                          <Text style={styles.muted}>
                            {week[day]
                              ? "Working day"
                              : "Weekly holiday"}
                          </Text>
                        </View>
                        <Switch
                          value={week[day]}
                          onValueChange={(value) =>
                            setWeek((current) => ({
                              ...current,
                              [day]: value,
                            }))
                          }
                          trackColor={{
                            false: C.borderLight,
                            true: GOLD,
                          }}
                          thumbColor={C.text}
                        />
                      </View>
                    ))}

                    <Button
                      title="Save Weekly Schedule"
                      primary
                      loading={weekSaving}
                      onPress={() => void saveWeek()}
                    />
                  </View>
                )}

                <View style={styles.sectionHeading}>
                  <View>
                    <Text style={styles.sectionEyebrow}>
                      DAILY APPOINTMENTS
                    </Text>
                    <Text style={styles.sectionTitle}>
                      One-Hour Slots
                    </Text>
                  </View>
                </View>

                <View style={styles.dateNavigator}>
                  <Pressable
                    onPress={() =>
                      setSlotDate((current) =>
                        addDays(current, -1)
                      )
                    }
                    style={styles.iconButton}
                  >
                    <ChevronLeft size={19} color={GOLD} />
                  </Pressable>

                  <View style={styles.flex}>
                    <Text style={styles.dateTitle}>
                      {formatDate(slotDate)}
                    </Text>
                    <Text style={styles.mutedCenter}>
                      {weekday(slotDate)}
                    </Text>
                  </View>

                  <Pressable
                    onPress={() =>
                      setSlotDate((current) =>
                        addDays(current, 1)
                      )
                    }
                    style={styles.iconButton}
                  >
                    <ChevronRight size={19} color={GOLD} />
                  </Pressable>
                </View>

                <Notice text={slotError} />

                {slotLoading ? (
                  <View style={styles.empty}>
                    <ActivityIndicator color={GOLD} />
                    <Text style={styles.muted}>
                      Loading available slots...
                    </Text>
                  </View>
                ) : slotData ? (
                  <>
                    <View style={styles.metricsGrid}>
                      <Metric
                        title="Total Slots"
                        value={slotEntries.length}
                        subtitle="One-hour blocks"
                      />
                      <Metric
                        title="Available"
                        value={availableSlots}
                        subtitle="Before booking checks"
                        color={SUCCESS}
                      />
                      <Metric
                        title="Unavailable"
                        value={
                          slotEntries.length - availableSlots
                        }
                        subtitle="Disabled or break"
                        color={ERROR}
                      />
                      <Metric
                        title="Breaks"
                        value={breaks.length}
                        subtitle="Scheduled"
                      />
                    </View>

                    {slotData.slot_duration_minutes !== 60 ? (
                      <Notice
                        text="Backend slot duration is not 60 minutes. Update backend scheduling configuration before saving."
                      />
                    ) : (
                      <View style={styles.slotGrid}>
                        {slotEntries.map((time) => {
                          const start = minutes(time);
                          const isOnBreak = overlap(
                            start,
                            start + 60,
                            breaks
                          );

                          const enabled =
                            slots[time] !== false;

                          return (
                            <Pressable
                              key={time}
                              disabled={isOnBreak}
                              onPress={() =>
                                setSlots((current) => ({
                                  ...current,
                                  [time]:
                                    current[time] === false,
                                }))
                              }
                              style={[
                                styles.slotCard,
                                enabled &&
                                  !isOnBreak &&
                                  styles.slotAvailable,
                                (!enabled || isOnBreak) &&
                                  styles.slotUnavailable,
                              ]}
                            >
                              <Clock3
                                size={16}
                                color={
                                  enabled && !isOnBreak
                                    ? SUCCESS
                                    : MUTED
                                }
                              />
                              <Text style={styles.slotTime}>
                                {formatTime(time)}
                              </Text>
                              <Text style={styles.slotSubtext}>
                                {isOnBreak
                                  ? "Break"
                                  : enabled
                                  ? "Available"
                                  : "Disabled"}
                              </Text>
                            </Pressable>
                          );
                        })}
                      </View>
                    )}

                    <View style={styles.sectionHeading}>
                      <View>
                        <Text style={styles.sectionEyebrow}>
                          SHIFT BREAKS
                        </Text>
                        <Text style={styles.sectionTitle}>
                          Break Management
                        </Text>
                      </View>
                    </View>

                    <View style={styles.panel}>
                      <View style={styles.breakFields}>
                        <View style={styles.flex}>
                          <Field
                            label="START (HH:MM)"
                            value={breakStart}
                            onChangeText={setBreakStart}
                          />
                        </View>
                        <View style={styles.flex}>
                          <Field
                            label="END (HH:MM)"
                            value={breakEnd}
                            onChangeText={setBreakEnd}
                          />
                        </View>
                      </View>

                      <Button
                        title="Add Break"
                        onPress={addBreak}
                        disabled={slotSaving}
                      />

                      {breaks.map((item) => (
                        <View
                          key={item.id}
                          style={styles.breakRow}
                        >
                          <Coffee size={17} color={GOLD} />
                          <Text style={styles.breakLabel}>
                            {formatTime(item.start)}
                            {" – "}
                            {formatTime(item.end)}
                          </Text>
                          <Pressable
                            onPress={() =>
                              setBreaks((current) =>
                                current.filter(
                                  (entry) =>
                                    entry.id !== item.id
                                )
                              )
                            }
                          >
                            <Trash2
                              size={18}
                              color={ERROR}
                            />
                          </Pressable>
                        </View>
                      ))}
                    </View>

                    <View style={styles.saveFooter}>
                      <Button
                        title="Save Daily Slots"
                        primary
                        loading={slotSaving}
                        disabled={
                          slotData.slot_duration_minutes !== 60
                        }
                        onPress={() => void saveSlots()}
                      />
                    </View>

                    <View style={styles.policy}>
                      <ShieldCheck
                        size={17}
                        color={GOLD}
                      />
                      <Text style={styles.policyText}>
                        These settings control slot
                        availability. Actual bookings and
                        conflicts are validated by FastAPI.
                      </Text>
                    </View>
                  </>
                ) : (
                  <View style={styles.empty}>
                    <CalendarDays
                      size={30}
                      color={GOLD}
                    />
                    <Text style={styles.muted}>
                      Unable to load slot data.
                    </Text>
                  </View>
                )}
              </>
            )}
          </>
        )}

        {/* ================================================
            PERFORMANCE TAB
        ================================================ */}
        {tab === "performance" && (
          <>
            <View style={styles.sectionHeading}>
              <View>
                <Text style={styles.sectionEyebrow}>
                  PERFORMANCE ANALYTICS
                </Text>
                <Text style={styles.sectionTitle}>
                  Team Insights
                </Text>
              </View>
              <BarChart3 size={21} color={GOLD} />
            </View>

            <ScrollView
              horizontal
              showsHorizontalScrollIndicator={false}
              contentContainerStyle={styles.horizontalPills}
            >
              {PERIODS.map((item) => (
                <Pill
                  key={item.key}
                  label={item.title}
                  active={period === item.key}
                  onPress={() => setPeriod(item.key)}
                />
              ))}
            </ScrollView>

            <Text style={styles.periodText}>
              {formatDate(range.from)} –{" "}
              {formatDate(range.to)}
            </Text>

            <Notice text={performanceError} />

            {performanceLoading ? (
              <View style={styles.empty}>
                <ActivityIndicator color={GOLD} />
                <Text style={styles.muted}>
                  Calculating team performance...
                </Text>
              </View>
            ) : (
              <>
                <View style={styles.metricsGrid}>
                  <Metric
                    title="Bookings"
                    value={performanceTotals.bookings}
                    subtitle="Selected period"
                  />
                  <Metric
                    title="Completed"
                    value={performanceTotals.completed}
                    subtitle="Finished services"
                    color={SUCCESS}
                  />
                  <Metric
                    title="Service Hours"
                    value={(
                      performanceTotals.minutes / 60
                    ).toFixed(1)}
                    subtitle="Completed work"
                  />
                  <Metric
                    title="Active Team"
                    value={activeWorkers}
                    subtitle="Professionals"
                  />
                </View>

                <View style={styles.sectionHeading}>
                  <View>
                    <Text style={styles.sectionEyebrow}>
                      INDIVIDUAL RESULTS
                    </Text>
                    <Text style={styles.sectionTitle}>
                      Worker Performance
                    </Text>
                  </View>
                </View>

                {stats.map((item) => (
                  <View
                    key={item.worker.id}
                    style={styles.performanceCard}
                  >
                    <View style={styles.workerTop}>
                      <View style={styles.avatar}>
                        <Text style={styles.avatarText}>
                          {initials(item.worker.full_name)}
                        </Text>
                      </View>
                      <View style={styles.flex}>
                        <Text style={styles.workerName}>
                          {item.worker.full_name}
                        </Text>
                        <Text style={styles.workerRole}>
                          {item.worker.role}
                        </Text>
                      </View>
                      <View style={styles.rateBadge}>
                        <Text style={styles.rateText}>
                          {item.rate === null
                            ? "N/A"
                            : `${item.rate.toFixed(0)}%`}
                        </Text>
                      </View>
                    </View>

                    <View style={styles.performanceNumbers}>
                      <View style={styles.performanceNumber}>
                        <Text style={styles.performanceValue}>
                          {item.total}
                        </Text>
                        <Text style={styles.performanceLabel}>
                          TOTAL
                        </Text>
                      </View>
                      <View style={styles.performanceNumber}>
                        <Text
                          style={[
                            styles.performanceValue,
                            { color: SUCCESS },
                          ]}
                        >
                          {item.completed}
                        </Text>
                        <Text style={styles.performanceLabel}>
                          COMPLETED
                        </Text>
                      </View>
                      <View style={styles.performanceNumber}>
                        <Text style={styles.performanceValue}>
                          {item.confirmed}
                        </Text>
                        <Text style={styles.performanceLabel}>
                          UPCOMING
                        </Text>
                      </View>
                      <View style={styles.performanceNumber}>
                        <Text
                          style={[
                            styles.performanceValue,
                            { color: ERROR },
                          ]}
                        >
                          {item.cancelled}
                        </Text>
                        <Text style={styles.performanceLabel}>
                          CANCELLED
                        </Text>
                      </View>
                    </View>

                    <Text style={styles.progressCaption}>
                      Completion rate for resolved bookings
                    </Text>

                    <View style={styles.progressTrack}>
                      <View
                        style={[
                          styles.progressFill,
                          {
                            width: `${
                              item.rate === null
                                ? 0
                                : Math.min(100, item.rate)
                            }%`,
                          },
                        ]}
                      />
                    </View>

                    <Text style={styles.workerFootnote}>
                      {item.pending} pending ·{" "}
                      {(item.minutes / 60).toFixed(1)} hours
                      of completed services
                    </Text>
                  </View>
                ))}

                {stats.length === 0 && (
                  <View style={styles.empty}>
                    <BarChart3 size={28} color={GOLD} />
                    <Text style={styles.emptyTitle}>
                      No Performance Data
                    </Text>
                  </View>
                )}
              </>
            )}
          </>
        )}
      </ScrollView>

      {/* ================================================
          WORKER CREATE / EDIT MODAL
      ================================================ */}
      <Modal
        visible={editor !== null}
        transparent
        animationType="slide"
        onRequestClose={() => {
          if (!saving) setEditor(null);
        }}
      >
        <KeyboardAvoidingView
          style={styles.overlay}
          behavior={
            Platform.OS === "ios"
              ? "padding"
              : "height"
          }
        >
          <View style={styles.modalCard}>
            <View style={styles.modalHeader}>
              <View style={styles.flex}>
                <Text style={styles.eyebrow}>
                  TEAM MANAGEMENT
                </Text>
                <Text style={styles.modalTitle}>
                  {editor?.id
                    ? "Edit Professional"
                    : "Add Professional"}
                </Text>
              </View>

              <Pressable
                disabled={saving}
                onPress={() => setEditor(null)}
                style={styles.iconButton}
              >
                <X size={19} color={C.text} />
              </Pressable>
            </View>

            <ScrollView
              keyboardShouldPersistTaps="handled"
              showsVerticalScrollIndicator={false}
              contentContainerStyle={styles.modalBody}
            >
              {editor && (
                <>
                  <Notice text={editorError} />

                  <Field
                    label="FULL NAME"
                    value={editor.fullName}
                    onChangeText={(value) =>
                      changeEditor("fullName", value)
                    }
                  />

                  <Field
                    label="PHONE NUMBER"
                    value={editor.phone}
                    keyboardType="phone-pad"
                    onChangeText={(value) =>
                      changeEditor("phone", value)
                    }
                  />

                  <Field
                    label="ROLE"
                    value={editor.role}
                    onChangeText={(value) =>
                      changeEditor("role", value)
                    }
                  />

                  <Field
                    label="EXPERIENCE (YEARS)"
                    value={editor.experience}
                    keyboardType="numeric"
                    onChangeText={(value) =>
                      changeEditor("experience", value)
                    }
                  />

                  <Field
                    label="SPECIALIZATIONS"
                    value={editor.specializations}
                    multiline
                    onChangeText={(value) =>
                      changeEditor("specializations", value)
                    }
                  />

                  <View style={styles.breakFields}>
                    <View style={styles.flex}>
                      <Field
                        label="SHIFT START"
                        value={editor.startTime}
                        onChangeText={(value) =>
                          changeEditor("startTime", value)
                        }
                      />
                    </View>

                    <View style={styles.flex}>
                      <Field
                        label="SHIFT END"
                        value={editor.endTime}
                        onChangeText={(value) =>
                          changeEditor("endTime", value)
                        }
                      />
                    </View>
                  </View>

                  <View style={styles.weekRow}>
                    <Text style={styles.workerName}>
                      Active Professional
                    </Text>
                    <Switch
                      value={editor.active}
                      onValueChange={(value) =>
                        changeEditor("active", value)
                      }
                      trackColor={{
                        false: C.borderLight,
                        true: GOLD,
                      }}
                    />
                  </View>

                  <View style={styles.modalButtons}>
                    <Button
                      title="Cancel"
                      disabled={saving}
                      onPress={() => setEditor(null)}
                    />
                    <Button
                      title={
                        saving
                          ? "Saving..."
                          : "Save Professional"
                      }
                      primary
                      loading={saving}
                      onPress={() => void saveWorker()}
                    />
                  </View>
                </>
              )}
            </ScrollView>
          </View>
        </KeyboardAvoidingView>
      </Modal>
    </SafeAreaView>
  );
}

