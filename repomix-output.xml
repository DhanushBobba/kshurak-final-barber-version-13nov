                <X size={18} color={COLORS.text} />
              </Pressable>
            </View>
            <ScrollView
              keyboardShouldPersistTaps="handled"
              contentContainerStyle={styles.modalBody}
            >
              {replyReview && (
                <>
                  <View style={styles.modalCustomer}>
                    <View style={styles.avatar}>
                      <Text style={styles.avatarText}>
