                      icon={
                        saving ? (
                          <ActivityIndicator
                            size="small"
                            color={COLORS.black}
                          />
                        ) : (
                          <Send
                            size={12}
                            color={COLORS.black}
                          />
                        )
                      }
                    />
                  </View>
                </>
              )}
            </ScrollView>
          </View>
        </KeyboardAvoidingView>
      </Modal>
    </SafeAreaView>
