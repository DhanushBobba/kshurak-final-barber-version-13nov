<file path="src/services/barberRegistrationApi.ts">
const API_BASE_URL = String(
  process.env.EXPO_PUBLIC_API_BASE_URL || ""
)
  .trim()
  .replace(/\/+$/, "");

export type RegistrationFile = {
  uri: string;
  name: string;
  mimeType: string;
  size: number;
};

export interface BarberRegistrationPayload {
  username: string;
  email: string;
  password: string;
  years_experience: number;
  shop_name: string;
  shop_phone: string;
  shop_address: string;
  shop_image: RegistrationFile;
  shop_documents: RegistrationFile[];
}

export interface BarberRegistrationResponse {
  id: string;
  status: "pending";
  message: string;
}

function requireBaseUrl(): string {
  if (!/^https?:\/\/[^/]+/i.test(API_BASE_URL)) {
    throw new Error(
      "EXPO_PUBLIC_API_BASE_URL is missing or invalid. " +
      "Check your Mobile Barber .env file."
    );
  }

  return API_BASE_URL;
}

function getErrorMessage(data: unknown): string {
  const fallback =
    "Registration failed. Please try again.";

  if (!data || typeof data !== "object") {
    return fallback;
  }

  const detail =
    (data as { detail?: unknown }).detail;

  if (typeof detail === "string") {
    return detail;
  }

  if (
    detail &&
    typeof detail === "object" &&
    !Array.isArray(detail)
  ) {
    const message =
      (detail as { message?: unknown }).message;

    if (typeof message === "string") {
      return message;
    }
  }

  if (Array.isArray(detail)) {
    return detail
      .map((item: unknown) => {
        if (typeof item === "string") {
          return item;
        }

        if (
          item &&
          typeof item === "object" &&
          "msg" in item
        ) {
          return String(
            (item as { msg: unknown }).msg
          );
        }

        return "Invalid field";
      })
      .join(", ");
  }

  return fallback;
}

function appendFile(
  formData: FormData,
  fieldName: string,
  file: RegistrationFile
): void {
  // React Native FormData supports local file objects.
  // The cast is required because DOM TypeScript definitions
  // don't describe React Native's {uri, name, type} format.
  formData.append(
    fieldName,
    {
      uri: file.uri,
      name: file.name,
      type: file.mimeType,
    } as unknown as Blob
  );
}

export async function registerBarber(
  payload: BarberRegistrationPayload
): Promise<BarberRegistrationResponse> {
  const baseUrl = requireBaseUrl();

  const formData = new FormData();

  formData.append(
    "username",
    payload.username.trim()
  );

  formData.append(
    "email",
    payload.email.trim().toLowerCase()
  );

  formData.append(
    "password",
    payload.password
  );

  formData.append(
    "years_experience",
    String(payload.years_experience)
  );

  formData.append(
    "shop_name",
    payload.shop_name.trim()
  );

  formData.append(
    "shop_phone",
    payload.shop_phone.trim()
  );

  formData.append(
    "shop_address",
    payload.shop_address.trim()
  );

  appendFile(
    formData,
    "shop_image",
    payload.shop_image
  );

  for (const document of payload.shop_documents) {
    appendFile(
      formData,
      "shop_documents",
      document
    );
  }

  let response: Response;

  try {
    response = await fetch(
      `${baseUrl}/api/v1/barber/register`,
      {
        method: "POST",
        headers: {
          Accept: "application/json",
        },
        body: formData,
      }
    );
  } catch {
    throw new Error(
      "Unable to connect to KSHURAK FastAPI. " +
      "Check the backend URL and network connection."
    );
  }

  const data: unknown =
    await response.json().catch(() => null);

  if (!response.ok) {
    throw new Error(getErrorMessage(data));
  }

  if (
    !data ||
    typeof data !== "object" ||
    typeof (data as { id?: unknown }).id !== "string" ||
    (data as { status?: unknown }).status !== "pending" ||
    typeof (data as { message?: unknown }).message !== "string"
  ) {
    throw new Error(
      "Unexpected registration response from the backend."
    );
  }

  return data as BarberRegistrationResponse;
}
</file>

<file path="src/services/bookingApi.ts">
import * as SecureStore from "expo-secure-store";

const API_BASE_URL = String(
  process.env.EXPO_PUBLIC_API_BASE_URL || ""
)
  .trim()
  .replace(/\/+$/, "");

const BOOKINGS_PATH = "/api/v1/barber/bookings";
const TOKEN_KEY = "kshurak_barber_token";

const configuredTimeout = Number(
  process.env.EXPO_PUBLIC_BOOKING_REQUEST_TIMEOUT_MS || 30000
);

const REQUEST_TIMEOUT_MS =
  Number.isFinite(configuredTimeout) && configuredTimeout > 0
    ? configuredTimeout
    : 30000;

export type BookingStatus =
  | "pending"
  | "confirmed"
  | "completed"
  | "cancelled"
  | "rejected";

export type BookingFilterStatus = BookingStatus | "all";

export type HairstylePreviewAngle = "front" | "left" | "right";

export interface BookingHairstylePreview {
  angle: HairstylePreviewAngle;
  image: string;
}

export interface BookingHairstyleSelection {
  version: 1;
  source: "virtual_tryon";
  scan_id: string;
  hairstyle_id: string;
  hairstyle_name: string;
  reference_image: string;
  style_analysis: string;
  face_shape: string | null;
  previews: BookingHairstylePreview[];
}

export interface BarberBooking {
  id: string;
  barber_id: string;
  worker_id: string | null;
  customer_id: string | null;
  customer_name: string;
  customer_phone: string | null;
  customer_image_url: string | null;
  service_name: string;
  service_duration_minutes: number;
  service_price: string | number;
  booking_date: string;
  start_time: string;
  end_time: string;
  status: BookingStatus;
  customer_notes: string | null;
  cancellation_reason: string | null;
  cancelled_by: string | null;
  confirmed_at: string | null;
  completed_at: string | null;
  cancelled_at: string | null;
  created_at: string;
  updated_at: string;

  hairstyle_selection?: BookingHairstyleSelection | null;
  has_hairstyle_selection?: boolean;
  hairstyle_name?: string | null;
  hairstyle_details_loaded?: boolean;
}

export interface BookingCounts {
  pending: number;
  confirmed: number;
  completed: number;
  cancelled: number;
  rejected: number;
}

export interface BookingListResponse {
  bookings: BarberBooking[];
  total: number;
  counts: BookingCounts;
}

export interface BookingActionResponse {
  message: string;
  booking: BarberBooking;
}

export interface BookingFilters {
  status?: BookingFilterStatus;
  dateFrom?: string;
  dateTo?: string;
}

export class BookingApiError extends Error {
  readonly status: number;
  readonly outcomeUnknown: boolean;

  constructor(
    message: string,
    status = 0,
    outcomeUnknown = false
  ) {
    super(message);
    this.name = "BookingApiError";
    this.status = status;
    this.outcomeUnknown = outcomeUnknown;
  }
}

function validateBaseUrl(): void {
  try {
    const url = new URL(API_BASE_URL);

    if (
      !["http:", "https:"].includes(url.protocol) ||
      !url.hostname ||
      url.username ||
      url.password ||
      url.search ||
      url.hash
    ) {
      throw new Error("Invalid backend URL.");
    }
  } catch {
    throw new BookingApiError(
      "Configure a valid EXPO_PUBLIC_API_BASE_URL in your mobile .env file."
    );
  }
}

async function getAccessToken(): Promise<string> {
  let token: string | null;

  try {
    token = await SecureStore.getItemAsync(TOKEN_KEY);
  } catch {
    throw new BookingApiError(
      "Unable to read the secure login session."
    );
  }

  if (!token?.trim()) {
    throw new BookingApiError(
      "Your session has expired. Please log in again.",
      401
    );
  }

  return token.trim();
}

function readError(body: unknown, fallback: string): string {
  if (!body || typeof body !== "object" || !("detail" in body)) {
    return fallback;
  }

  const detail = (body as { detail: unknown }).detail;

  if (typeof detail === "string" && detail.trim()) {
    return detail;
  }

  if (Array.isArray(detail)) {
    const messages = detail
      .map((item: unknown) => {
        if (item && typeof item === "object" && "msg" in item) {
          return String(item.msg);
        }

        return typeof item === "string" ? item : "";
      })
      .filter(Boolean);

    return messages.length ? messages.join(", ") : fallback;
  }

  if (
    detail &&
    typeof detail === "object" &&
    "message" in detail &&
    typeof detail.message === "string"
  ) {
    return detail.message;
  }

  return fallback;
}

function bookingPath(bookingId: string): string {
  const id = bookingId.trim();

  if (!id) {
    throw new BookingApiError("Booking identification is missing.");
  }

  return `/${encodeURIComponent(id)}`;
}

async function bookingRequest<T>(
  path: string,
  method: "GET" | "POST" = "GET",
  payload?: unknown,
  signal?: AbortSignal
): Promise<T> {
  validateBaseUrl();

  const token = await getAccessToken();
  const controller = new AbortController();
  const isMutation = method === "POST";

  let timedOut = false;

  const abortFromCaller = () => controller.abort();

  if (signal?.aborted) {
    controller.abort();
  } else {
    signal?.addEventListener("abort", abortFromCaller, {
      once: true,
    });
  }

  const timer = setTimeout(() => {
    timedOut = true;
    controller.abort();
  }, REQUEST_TIMEOUT_MS);

  const headers: Record<string, string> = {
    Accept: "application/json",
    Authorization: `Bearer ${token}`,
  };

  if (payload !== undefined) {
    headers["Content-Type"] = "application/json";
  }

  try {
    const response = await fetch(
      `${API_BASE_URL}${BOOKINGS_PATH}${path}`,
      {
        method,
        headers,
        body:
          payload === undefined
            ? undefined
            : JSON.stringify(payload),
        signal: controller.signal,
      }
    );

    const responseText = await response.text();

    let body: unknown = null;

    if (responseText) {
      try {
        body = JSON.parse(responseText);
      } catch {
        // An invalid response is handled below.
      }
    }

    if (!response.ok) {
      const fallback =
        response.status === 401
          ? "Your session has expired. Please log in again."
          : response.status === 403
          ? "You do not have permission to manage bookings."
          : response.status === 404
          ? "Booking not found or booking API unavailable."
          : `Booking request failed (${response.status}).`;

      throw new BookingApiError(
        readError(body, fallback),
        response.status,
        isMutation && response.status >= 500
      );
    }

    if (!body || typeof body !== "object") {
      throw new BookingApiError(
        isMutation
          ? "The booking result could not be verified. Refresh bookings before trying again."
          : "The backend returned an invalid bookings response.",
        response.status,
        isMutation
      );
    }

    return body as T;
  } catch (error: unknown) {
    if (error instanceof BookingApiError) {
      throw error;
    }

    if (signal?.aborted) {
      throw error;
    }

    const message = timedOut
      ? isMutation
        ? "The booking update timed out. Its result is unknown. Refresh bookings before trying again."
        : "Loading bookings timed out. Please use Refresh to try again."
      : isMutation
      ? "The connection was interrupted. Check the booking status before repeating the update."
      : "Cannot connect to the KSHURAK backend. Check the server and your phone's network.";

    throw new BookingApiError(message, 0, isMutation);
  } finally {
    clearTimeout(timer);
    signal?.removeEventListener("abort", abortFromCaller);
  }
}

export async function getBarberBookings(
  filters: BookingFilters = {},
  signal?: AbortSignal
): Promise<BookingListResponse> {
  const params = ["include_hairstyle=false"];

  if (filters.status && filters.status !== "all") {
    params.push(`status=${encodeURIComponent(filters.status)}`);
  }

  if (filters.dateFrom) {
    params.push(
      `date_from=${encodeURIComponent(filters.dateFrom)}`
    );
  }

  if (filters.dateTo) {
    params.push(
      `date_to=${encodeURIComponent(filters.dateTo)}`
    );
  }

  const result = await bookingRequest<BookingListResponse>(
    `?${params.join("&")}`,
    "GET",
    undefined,
    signal
  );

  if (!Array.isArray(result.bookings)) {
    throw new BookingApiError("Invalid bookings list received.");
  }

  return result;
}

export async function getBarberBookingById(
  bookingId: string,
  signal?: AbortSignal
): Promise<BarberBooking> {
  const booking = await bookingRequest<BarberBooking>(
    bookingPath(bookingId),
    "GET",
    undefined,
    signal
  );

  if (booking.id !== bookingId.trim()) {
    throw new BookingApiError("Invalid booking details received.");
  }

  return booking;
}

export async function acceptBarberBooking(
  bookingId: string,
  workerId?: string | null
): Promise<BookingActionResponse> {
  return bookingRequest<BookingActionResponse>(
    `${bookingPath(bookingId)}/accept`,
    "POST",
    { worker_id: workerId?.trim() || null }
  );
}

export async function rejectBarberBooking(
  bookingId: string,
  reason: string
): Promise<BookingActionResponse> {
  const trimmed = reason.trim();

  if (trimmed.length < 3 || trimmed.length > 500) {
    throw new BookingApiError(
      "Enter a rejection reason between 3 and 500 characters."
    );
  }

  return bookingRequest<BookingActionResponse>(
    `${bookingPath(bookingId)}/reject`,
    "POST",
    { reason: trimmed }
  );
}

export async function completeBarberBooking(
  bookingId: string
): Promise<BookingActionResponse> {
  return bookingRequest<BookingActionResponse>(
    `${bookingPath(bookingId)}/complete`,
    "POST"
  );
}

export async function cancelBarberBooking(
  bookingId: string,
  reason: string
): Promise<BookingActionResponse> {
  const trimmed = reason.trim();

  if (trimmed.length < 3 || trimmed.length > 500) {
    throw new BookingApiError(
      "Enter a cancellation reason between 3 and 500 characters."
    );
  }

  return bookingRequest<BookingActionResponse>(
    `${bookingPath(bookingId)}/cancel`,
    "POST",
    { reason: trimmed }
  );
}
</file>

<file path="src/services/customersApi.ts">
import * as SecureStore from "expo-secure-store";

const API_BASE_URL = String(
  process.env.EXPO_PUBLIC_API_BASE_URL || ""
).trim().replace(/\/+$/, "");

const CUSTOMERS_PATH = "/api/v1/barber/customers";
const TOKEN_KEY = "kshurak_barber_token";

export type CustomerRelationship =
  | "new"
  | "returning"
  | "regular"
  | "inactive";

export interface CustomerSummary {
  total_customers: number;
  new_this_month: number;
  returning_customers: number;
  regular_customers: number;
  inactive_customers: number;
  retention_rate: number;
}

export interface CustomerProfile {
  customer_key: string;
  customer_id: string | null;
  name: string;
  phone: string;
  image_url: string | null;
  relationship: CustomerRelationship;
  total_bookings: number;
  completed_visits: number;
  total_spent: number;
  first_booking: string;
  last_booking: string;
  last_visit: string | null;
  favorite_service: string | null;
  pending_bookings: number;
  confirmed_bookings: number;
  cancelled_bookings: number;
  rejected_bookings: number;
}

export interface CustomerVisit {
  booking_id: string;
  booking_date: string;
  start_time: string;
  service_name: string;
  service_price: number;
  status: string;
  customer_notes: string | null;
}

export interface CustomersResponse {
  summary: CustomerSummary;
  customers: CustomerProfile[];
}

export interface CustomerDetailResponse {
  customer: CustomerProfile;
  visits: CustomerVisit[];
}

export class CustomersApiError extends Error {
  status: number;

  constructor(message: string, status = 0) {
    super(message);
    this.name = "CustomersApiError";
    this.status = status;
  }
}

async function accessToken(): Promise<string> {
  let token: string | null;

  try {
    token = await SecureStore.getItemAsync(TOKEN_KEY);
  } catch {
    throw new CustomersApiError(
      "Unable to read your secure login session."
    );
  }

  if (!token) {
    throw new CustomersApiError(
      "Your Barber session has expired. Please log in again.",
      401
    );
  }

  return token;
}

function getErrorMessage(status: number, data: unknown): string {
  let detail = `Customers request failed (${status}).`;

  if (data && typeof data === "object" && "detail" in data) {
    const value = (data as { detail: unknown }).detail;

    if (typeof value === "string") {
      detail = value;
    } else if (Array.isArray(value)) {
      detail = value.map((item: unknown) => {
        if (item && typeof item === "object" && "msg" in item) {
          return String((item as { msg: unknown }).msg);
        }
        return String(item);
      }).join(", ");
    } else if (
      value &&
      typeof value === "object" &&
      "message" in value
    ) {
      detail = String((value as { message: unknown }).message);
    }
  }

  if (status === 401) {
    return "Your login session is invalid or expired. Please log in again.";
  }
  if (status === 403) {
    return "You do not have permission to view customers.";
  }
  if (status === 404) {
    return "Customer not found or the Customers API is unavailable.";
  }

  return detail;
}

async function customersRequest<T>(
  path: string,
  signal?: AbortSignal
): Promise<T> {
  if (!/^https?:\/\/[^/]+/i.test(API_BASE_URL)) {
    throw new CustomersApiError(
      "EXPO_PUBLIC_API_BASE_URL is missing or invalid."
    );
  }

  const token = await accessToken();
  let response: Response;

  try {
    response = await fetch(
      `${API_BASE_URL}${CUSTOMERS_PATH}${path}`,
      {
        method: "GET",
        signal,
        headers: {
          Authorization: `Bearer ${token}`,
          Accept: "application/json",
        },
      }
    );
  } catch (error: unknown) {
    if (
      signal?.aborted ||
      (error instanceof Error && error.name === "AbortError")
    ) {
      throw error;
    }

    throw new CustomersApiError(
      "Unable to connect to KSHURAK. Check your backend and phone network."
    );
  }

  const data: unknown = await response.json().catch(() => null);

  if (!response.ok) {
    throw new CustomersApiError(
      getErrorMessage(response.status, data),
      response.status
    );
  }

  if (data === null || data === undefined) {
    throw new CustomersApiError(
      "The Customers API returned an empty response."
    );
  }

  return data as T;
}

export async function getShopCustomers(
  signal?: AbortSignal
): Promise<CustomersResponse> {
  const result = await customersRequest<CustomersResponse>("", signal);

  if (
    !result ||
    !result.summary ||
    !Array.isArray(result.customers)
  ) {
    throw new CustomersApiError(
      "Invalid Customers API response received."
    );
  }

  return result;
}

export async function getShopCustomerDetails(
  customerKey: string,
  signal?: AbortSignal
): Promise<CustomerDetailResponse> {
  if (!customerKey.trim()) {
    throw new CustomersApiError("Customer identification is missing.");
  }

  const result = await customersRequest<CustomerDetailResponse>(
    `/${encodeURIComponent(customerKey)}`,
    signal
  );

  if (
    !result ||
    !result.customer ||
    !Array.isArray(result.visits)
  ) {
    throw new CustomersApiError(
      "Invalid customer profile response received."
    );
  }

  return result;
}
