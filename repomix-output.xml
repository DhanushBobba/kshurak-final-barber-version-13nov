<file path="src/screens/auth/LoginScreen.tsx">
import React, { useEffect, useRef, useState } from "react";
import {
  ActivityIndicator,
  Image,
  ImageBackground,
  KeyboardAvoidingView,
  Modal,
  Platform,
  Pressable,
  ScrollView,
  StatusBar,
  StyleSheet,
  Text,
  TextInput,
  View,
} from "react-native";
import { LinearGradient } from "expo-linear-gradient";
import {
  AlertCircle,
  ArrowRight,
  CheckCircle2,
  Clock3,
  Eye,
  EyeOff,
  Globe,
  LockKeyhole,
  Mail,
  Scissors,
  ShieldAlert,
  ShieldCheck,
  X,
} from "lucide-react-native";

import { COLORS } from "../../constants/colors";
import {
  calculateTokenExpiry,
  clearRememberedIdentifier,
  getRememberedIdentifier,
  saveBarberSession,
  saveRememberedIdentifier,
} from "../../utils/storage";

type LoginErrorCode =
  | "ADMIN_APPROVAL_REQUIRED"
  | "APPLICATION_REJECTED"
  | "ACCOUNT_NOT_APPROVED"
  | "EMAIL_ACTIVATION_REQUIRED"
  | "INVALID_CREDENTIALS"
  | "LOGIN_ERROR";

type PopupCode = LoginErrorCode | "LOGIN_SUCCESS";

type LoginPopup = {
  code: PopupCode;
  title: string;
  message: string;
};

type LoginResponse = {
  access_token: string;
  token_type: string;
  expires_in: number;
  barber_id: string;
  username: string;
  message?: string;
};

type Props = {
  onRegister?: () => void;
  onForgotPassword?: () => void;
  onDashboard?: () => void;
};

const LOGO = require("../../../assets/images/logo.png");
const BACKGROUND = require("../../../assets/images/barber-shop.png");

const API_BASE_URL = String(
  process.env.EXPO_PUBLIC_API_BASE_URL || ""
)
  .trim()
  .replace(/\/+$/, "");

const POPUP_TITLES: Record<LoginErrorCode, string> = {
  ADMIN_APPROVAL_REQUIRED: "Admin Approval Required",
  APPLICATION_REJECTED: "Application Not Approved",
  ACCOUNT_NOT_APPROVED: "Account Not Approved",
  EMAIL_ACTIVATION_REQUIRED: "Email Activation Required",
  INVALID_CREDENTIALS: "Invalid Login Details",
  LOGIN_ERROR: "Login Unavailable",
};

class BarberLoginError extends Error {
  readonly code: LoginErrorCode;

  constructor(code: LoginErrorCode, message: string) {
    super(message);
    this.name = "BarberLoginError";
    this.code = code;
    Object.setPrototypeOf(this, BarberLoginError.prototype);
  }
}

function isRecord(
  value: unknown
): value is Record<string, unknown> {
  return (
    typeof value === "object" &&
    value !== null &&
    !Array.isArray(value)
  );
}

async function loginBarber(
  identifier: string,
  password: string
): Promise<LoginResponse> {
  if (!/^https?:\/\/[^/]+/i.test(API_BASE_URL)) {
    throw new BarberLoginError(
      "LOGIN_ERROR",
      "Configure a valid EXPO_PUBLIC_API_BASE_URL."
    );
  }

  let response: Response;

  try {
    response = await fetch(
      `${API_BASE_URL}/api/v1/barber/login`,
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify({
          identifier,
          password,
        }),
      }
    );
  } catch {
    throw new BarberLoginError(
      "LOGIN_ERROR",
      "Cannot connect to KSHURAK backend. Check your internet connection."
    );
  }

  const data: unknown = await response
    .json()
    .catch(() => null);

  if (!response.ok) {
    const detail = isRecord(data)
      ? data.detail
      : null;

    if (
      isRecord(detail) &&
      typeof detail.code === "string" &&
      detail.code in POPUP_TITLES
    ) {
      const code = detail.code as LoginErrorCode;

      throw new BarberLoginError(
        code,
        typeof detail.message === "string"
          ? detail.message
          : "Login is not allowed."
      );
    }

    const message =
      typeof detail === "string"
        ? detail
        : isRecord(detail) &&
            typeof detail.message === "string"
        ? detail.message
        : "Unable to log in. Please try again.";

    throw new BarberLoginError(
      response.status === 401
        ? "INVALID_CREDENTIALS"
        : "LOGIN_ERROR",
      message
    );
  }

  if (
    !isRecord(data) ||
    typeof data.access_token !== "string" ||
    !data.access_token.trim() ||
    typeof data.barber_id !== "string" ||
    !data.barber_id.trim() ||
    typeof data.username !== "string" ||
    !data.username.trim()
  ) {
    throw new BarberLoginError(
      "LOGIN_ERROR",
      "Invalid login response from the backend."
    );
  }

  // The backend currently returns expires_in.
  // Do not assume this is a refreshable session.
  const expiresIn = Number(data.expires_in);

  if (
    !Number.isFinite(expiresIn) ||
    expiresIn <= 0
  ) {
    throw new BarberLoginError(
      "LOGIN_ERROR",
      "The backend did not provide a valid access-token lifetime."
    );
  }

  return {
    access_token: data.access_token,
    token_type:
      typeof data.token_type === "string"
        ? data.token_type
        : "bearer",
    expires_in: expiresIn,
    barber_id: data.barber_id,
    username: data.username,
    message:
      typeof data.message === "string"
        ? data.message
        : undefined,
  };
}

export default function LoginScreen({
  onRegister,
  onForgotPassword,
  onDashboard,
}: Props) {
  const [identifier, setIdentifier] = useState("");
  const [password, setPassword] = useState("");
  const [showPassword, setShowPassword] =
    useState(false);
  const [rememberMe, setRememberMe] =
    useState(false);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [popup, setPopup] =
    useState<LoginPopup | null>(null);

  const submittingRef = useRef(false);

  useEffect(() => {
    let active = true;

    void getRememberedIdentifier()
      .then((saved) => {
        if (!active || !saved) return;
        setIdentifier(saved);
        setRememberMe(true);
      })
      .catch(() => {
        // Remembered username is optional.
      });

    return () => {
      active = false;
    };
  }, []);

  const handleLogin = async () => {
    if (submittingRef.current) return;

    setError("");

    const cleanIdentifier = identifier.trim();

    if (!cleanIdentifier || !password) {
      setError(
        "Please enter your email/username and password."
      );
      return;
    }

    submittingRef.current = true;
    setLoading(true);

    try {
      const result = await loginBarber(
        cleanIdentifier,
        password
      );

      const expiresAt = calculateTokenExpiry(
        result.expires_in
      );

      if (!expiresAt) {
        throw new BarberLoginError(
          "LOGIN_ERROR",
          "Unable to determine session expiration."
        );
      }

      await saveBarberSession({
        token: result.access_token,
        barberId: result.barber_id,
        username: result.username,
        expiresAt,
      });

      if (rememberMe) {
        await saveRememberedIdentifier(
          cleanIdentifier
        );
      } else {
        await clearRememberedIdentifier();
      }

      setPassword("");

      setPopup({
        code: "LOGIN_SUCCESS",
        title: "Login Successful",
        message:
          `Welcome back, ${result.username}! ` +
          "Your account has been verified. " +
          "Continue to your dashboard.",
      });
    } catch (err: unknown) {
      if (err instanceof BarberLoginError) {
        setPopup({
          code: err.code,
          title: POPUP_TITLES[err.code],
          message: err.message,
        });
      } else {
        setError(
          err instanceof Error
            ? err.message
            : "Something went wrong. Please try again."
        );
      }
    } finally {
      submittingRef.current = false;
      setLoading(false);
    }
  };

  const closePopup = () => {
    const success =
      popup?.code === "LOGIN_SUCCESS";

    setPopup(null);

    if (success) {
      onDashboard?.();
    }
  };

  return (
    <View style={styles.root}>
