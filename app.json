
{
  "expo": {
    "name": "KSHURAK Barber",
    "slug": "mobile-barber",
    "version": "1.0.0",
    "scheme": "kshurakbarber",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/app-icon.png"
    },
    "android": {
      "icon": "./assets/images/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#070708"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.intelerateam.mobilebarber"
    },
    "web": {
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-video",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "895c5927-7389-4325-8e6e-d535c8bedb80"
      }
    }
  }
}
